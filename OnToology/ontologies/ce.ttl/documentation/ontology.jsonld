  } ]
}, {
  "@id" : "http://www.softlang.org/ontologies/ce#ContinuousIntegration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.softlang.org/ontologies/tbox#ConceptualEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A software engineering practice in which code changes are frequently integrated into a shared repository and automatically built and tested to detect integration problems early."
  } ],
