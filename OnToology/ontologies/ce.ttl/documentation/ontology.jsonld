    "@id" : "https://en.wikipedia.org/wiki/Continuous_delivery"
  } ]
}, {
  "@id" : "http://www.softlang.org/ontologies/ce#ContinuousDeployment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.softlang.org/ontologies/tbox#ConceptualEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A software engineering practice in which code changes that pass automated validation are automatically released to production environments."
  } ],
