             <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#SoftwareDesignApproach> ;
             rdfs:comment "An engineering activity that restructures the internal design of a program artifact without changing its externally observable behavior."@en ;
             rdfs:label "Refactoring"@en ;
             <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Code_refactoring> .


:ReleaseActivity rdfs:comment "An engineering activity concerned with preparing, versioning, packaging, managing, or rolling back software releases."@en ;
                 rdfs:label "Release activity"@en ;
                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_release_life_cycle> .


:ReleaseManagement rdfs:comment "The software engineering activity of planning, coordinating, and controlling the release of software versions to users or operational environments."@en ;
                   rdfs:label "Release management"@en ;
                   <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Release_management> .


:RequirementsAnalysis <http://www.softlang.org/ontologies/tbox#hasAffectedArtifact> <http://www.softlang.org/ontologies/ae#RequirementsArtifact> ;
                      <http://www.softlang.org/ontologies/tbox#hasInputArtifact> <http://www.softlang.org/ontologies/ae#RequirementsArtifact> ;
                      <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#RequirementsSpecificationLanguage> ;
                      <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#RequirementsTool> ;
                      rdfs:comment "An engineering activity that identifies, elicits, analyzes, documents, and manages stakeholder requirements for a software system."@en ;
                      rdfs:label "Requirements analysis"@en ;
                      <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Requirements_engineering> .


:RequirementsElicitation rdfs:comment "The process of discovering, gathering, and clarifying stakeholders' needs, expectations, and constraints for a software system."@en ;
                         rdfs:label "Requirements elicitation"@en ;
                         <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Requirements_elicitation> .


:RequirementsEngineeringActivity rdfs:comment "A software engineering activity concerned with eliciting, analyzing, specifying, validating, prioritizing, and managing system requirements."@en ;
                                 rdfs:label "Requirements engineering activity"@en ;
                                 <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Requirements_engineering> .


:RequirementsManagement rdfs:comment "The activity of managing, organizing, tracing, and controlling requirements throughout the software development lifecycle."@en ;
                        rdfs:label "Requirements management"@en ;
                        <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Requirements_engineering> .


:RequirementsPrioritization rdfs:comment "The activity of determining the relative importance or implementation order of requirements to support planning and resource allocation."@en ;
                            rdfs:label "Requirements prioritization"@en ;
                            <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Requirements_engineering> .


:RequirementsSpecification <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#RequirementsArtifact> ;
                           <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#RequirementsSpecificationLanguage> ;
                           <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#RequirementsTool> ;
                           rdfs:comment "An engineering activity that elicits, analyzes, documents, and manages requirements, producing a requirements artifact with support from requirements specification languages and tools."@en ;
                           rdfs:label "Requirements specification"@en ;
                           <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_requirements_specification> .


:RequirementsValidation rdfs:comment "Activity concerned with evaluating requirements to ensure that they accurately reflect stakeholder needs and are complete, consistent, feasible, and testable."@en ;
                        rdfs:label "Requirements validation"@en ;
                        <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Requirements_engineering> .


:ResourceAllocation rdfs:comment "The planning and management activity of assigning available resources, such as personnel, time, budget, and equipment, to tasks or projects."@en ;
                    rdfs:label "Resource allocation"@en ;
                    <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Resource_allocation> .


:RiskManagement rdfs:comment "Engineering activity for identifying, assessing, prioritizing, and mitigating risks that may affect a software project or its outcomes."@en ;
                rdfs:label "Risk management"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Risk_management> .


:Roadmapping rdfs:comment "An engineering activity for defining and maintaining a technology or product roadmap that outlines strategic goals, planned developments, and their timeline."@en ;
             rdfs:label "Roadmapping"@en ;
             <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Technology_roadmap> .


:RollbackManagement rdfs:comment "Management of procedures for reverting a software release or deployment to a previous stable version when problems occur."@en ;
                    rdfs:label "Rollback management"@en ;
                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Rollback_(data_management)> .


:SchemaConcept rdfs:comment "A language concept concerning schemas that define the permitted structure, elements, attributes, or constraints of artifacts or data."@en ;
               rdfs:label "Schema concept"@en .


:ScopeConcept rdfs:comment "A primitive language concept that characterizes the region of a program in which a name binding is visible and can be referenced."@en ;
              rdfs:label "Scope concept"@en .


:SecurityManagement rdfs:comment "An engineering activity concerned with establishing, implementing, and maintaining policies, controls, and processes to protect information systems and manage security risks."@en ;
                    rdfs:label "Security management"@en ;
                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Information_security_management> .


:SecurityTesting rdfs:comment "A validation testing activity that evaluates a software system for vulnerabilities, threats, and other security weaknesses."@en ;
                 rdfs:label "Security testing"@en ;
                 <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Security_testing> .


:StakeholderManagement rdfs:comment "Planning and management activity concerned with identifying, engaging, and managing stakeholders involved in or affected by a software project."@en ;
                       rdfs:label "Stakeholder management"@en ;
                       <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Stakeholder_management> .


:StateConcept rdfs:comment "A primitive language concept concerning the state of a computation or system, including how state is represented, maintained, or changed over time."@en ;
              rdfs:label "State concept"@en .


