###  http://www.softlang.org/ontologies/ce#ValidationTestingActivity
:ValidationTestingActivity rdf:type owl:NamedIndividual ,
                                    <http://www.softlang.org/ontologies/tbox#ConceptualEntity> .


###  http://www.softlang.org/ontologies/ce#ValueSemantics
:ValueSemantics rdf:type owl:NamedIndividual ,
                         :MutabilityConcept ,
                         <http://www.softlang.org/ontologies/tbox#ConceptualEntity> ;
                rdfs:label "Value semantics"@en ;
                <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Value_semantics> .


###  http://www.softlang.org/ontologies/ce#VariablesAsState
:VariablesAsState rdf:type owl:NamedIndividual ,
                           :StateConcept ,
                           <http://www.softlang.org/ontologies/tbox#ConceptualEntity> ;
                  rdfs:label "Variables as state"@en ;
                  <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/State_(computer_science)> .


###  http://www.softlang.org/ontologies/ce#Variants
:Variants rdf:type owl:NamedIndividual ,
                   :DataConcept ,
                   <http://www.softlang.org/ontologies/tbox#ConceptualEntity> ;
          rdfs:label "Variants"@en ;
          <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Tagged_union> .


###  http://www.softlang.org/ontologies/ce#VerificationActivity
:VerificationActivity rdf:type owl:NamedIndividual ,
                               <http://www.softlang.org/ontologies/tbox#ConceptualEntity> .


###  http://www.softlang.org/ontologies/ce#VerificationActivityCategory
:VerificationActivityCategory rdf:type owl:NamedIndividual ,
                                       <http://www.softlang.org/ontologies/tbox#ConceptualEntity> .


###  http://www.softlang.org/ontologies/ce#VerificationTestingActivity
:VerificationTestingActivity rdf:type owl:NamedIndividual ,
                                      <http://www.softlang.org/ontologies/tbox#ConceptualEntity> .


###  http://www.softlang.org/ontologies/ce#Versioning
:Versioning rdf:type owl:NamedIndividual ,
                     <http://www.softlang.org/ontologies/tbox#ConceptualEntity> .


###  http://www.softlang.org/ontologies/ce#WeakTyping
:WeakTyping rdf:type owl:NamedIndividual ,
                     :TypeConcept ,
                     <http://www.softlang.org/ontologies/tbox#ConceptualEntity> ;
            rdfs:label "Weak typing"@en ;
            <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Strong_and_weak_typing> .


###  http://www.softlang.org/ontologies/ce#XMLware
:XMLware rdf:type owl:NamedIndividual ,
                  <http://www.softlang.org/ontologies/tbox#ConceptualEntity> ,
                  <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> ;
         <http://www.softlang.org/ontologies/tbox#hasArtifact> <http://www.softlang.org/ontologies/ae#XMLDocumentArtifact> ,
                                                               <http://www.softlang.org/ontologies/ae#XMLSchemaArtifact> ;
         <http://www.softlang.org/ontologies/tbox#hasTool> <http://www.softlang.org/ontologies/te#QueryProcessor> ,
                                                           <http://www.softlang.org/ontologies/te#TransformationEngine> ,
                                                           <http://www.softlang.org/ontologies/te#Validator> ,
                                                           <http://www.softlang.org/ontologies/te#XMLProcessor> ;
         rdfs:comment "technological space centered on XML documents, XML schemas, XML querying, XML transformation, and XML processing"@en ;
         rdfs:label "XMLware"@en .


#################################################################
#    Annotations
#################################################################

:APIDesign <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#APIDescriptionArtifact> ;
           <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#InterfaceDescriptionLanguage> ;
           <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#APIWorkbench> ;
           <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#SoftwareDesignApproach> ;
           rdfs:comment "An engineering activity concerned with designing an application programming interface (API), including its operations, data structures, interaction conventions, and usage contracts."@en ;
           rdfs:label "API design"@en ;
           <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/API> .


:AbstractionConcept rdfs:comment "A primitive language concept that groups mechanisms for managing complexity by emphasizing essential characteristics while hiding irrelevant implementation details."@en ;
                    rdfs:label "Abstraction concept"@en .


:AcceptanceTesting rdfs:comment "A validation testing activity in which a system is evaluated against agreed acceptance criteria to determine whether it satisfies stakeholder or user requirements."@en ;
                   rdfs:label "Acceptance testing"@en ;
                   <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Acceptance_testing> .


:Auditing rdfs:comment "A quality and governance activity that systematically examines software artifacts, processes, or systems to assess compliance with specified requirements, standards, or policies."@en ;
          rdfs:label "Auditing"@en ;
          <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Audit> .


:Backup rdfs:comment "An operations and maintenance activity that creates a copy of data or system state so that it can be restored later."@en ;
        rdfs:label "Backup"@en ;
        <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Backup> .


:BindingConcept rdfs:comment "A primitive language concept concerning the association of names with program entities and the time at which such associations are established."@en ;
                rdfs:label "Binding concept"@en .


:BugFixing rdfs:comment "An operations and maintenance activity that identifies, diagnoses, and corrects defects (bugs) in software."@en ;
           rdfs:label "Bug fixing"@en ;
           <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_bug> .


:BuildScripting <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#BuildScriptArtifact> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#BuildScriptingLanguage> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#BuildTool> ;
                rdfs:comment "An implementation activity that automates the building of software artifacts using build scripts, build tools, and build-scripting languages."@en ;
                rdfs:label "Build scripting"@en ;
                <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Build_automation> .


:CapacityPlanning rdfs:comment "An operations and maintenance activity that determines and plans the computing resources required to meet anticipated workload and performance demands."@en ;
                  rdfs:label "Capacity planning"@en ;
                  <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Capacity_management> .


:ChangeManagement rdfs:comment "An evolution and improvement activity concerned with planning, implementing, and controlling changes to software systems, their artifacts, and the associated development processes."@en ;
                  rdfs:label "Change management"@en ;
                  <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Change_management> .


:CodeGeneration <http://www.softlang.org/ontologies/tbox#hasInputArtifact> <http://www.softlang.org/ontologies/ae#GrammarArtifact> ,
                                                                           <http://www.softlang.org/ontologies/ae#ModelArtifact> ;
                <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#ModelTransformationLanguage> ,
                                                                                <http://www.softlang.org/ontologies/pe#ProgrammingLanguage> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#ModelTransformationEngine> ;
                <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#MetaprogrammingApproach> ;
                rdfs:comment "An implementation activity that transforms grammar or model artifacts into program artifacts, typically using programming or model transformation languages and supporting tools."@en ;
                rdfs:label "Code generation"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://dbpedia.org/resource/Code_generation_(compiler)> ,
                                                             <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
                <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Code_generation_(compiler)> .


:CodeGenerationConcept rdfs:comment "A language concept concerning the automatic production of source code or other executable code from higher-level specifications, models, templates, or programs."@en ;
                       rdfs:label "Code generation concept"@en ;
                       <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://dbpedia.org/resource/Code_generation_(compiler)> ,
                                                                    <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
                       <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Code_generation_(compiler)> .


:CodeInspection <http://www.softlang.org/ontologies/tbox#hasInputArtifact> <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/pe#ProgrammingLanguage> ;
                rdfs:comment "A verification activity in which source code is systematically examined, typically without executing it, to identify defects and assess compliance with requirements or coding standards."@en ;
                rdfs:label "Code inspection"@en ;
                <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_inspection> .


:CodeReview <http://www.softlang.org/ontologies/tbox#hasInputArtifact> <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
            <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/pe#ProgrammingLanguage> ;
            rdfs:comment "An implementation and verification activity in which source code is systematically examined to identify defects, improve quality, and ensure compliance with standards and requirements."@en ;
            rdfs:label "Code review"@en ;
            <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Code_review> .


:Coding <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
        <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/pe#ProgrammingLanguage> ;
        <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#Compiler> ,
                                                                    <http://www.softlang.org/ontologies/te#Interpreter> ;
        rdfs:comment "The activity of writing source code in a programming language to implement a software design or specification."@en ;
        rdfs:label "Coding"@en ;
        <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Computer_programming> .


:ComplianceManagement rdfs:comment "An engineering activity concerned with ensuring that software systems, development processes, and related artifacts comply with applicable regulations, standards, policies, and governance requirements."@en ;
                      rdfs:label "Compliance management"@en ;
                      <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Regulatory_compliance> .


:ConcurrencyConcept rdfs:comment "A primitive language concept concerning the execution of multiple computations during overlapping time periods, including mechanisms for coordinating and communicating among them."@en ;
                    rdfs:label "Concurrency concept"@en .


:ConfigurationManagementPlanning rdfs:comment "A planning and management activity that defines how software configuration items, changes, versions, and related records are identified, controlled, and maintained throughout a project or product lifecycle."@en ;
                                 rdfs:label "Configuration management planning"@en ;
                                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Configuration_management> .


:ConstraintConcept rdfs:comment "A language concept concerning the specification and enforcement of constraints that restrict the valid states, structures, or relationships in software artifacts or data."@en ;
                   rdfs:label "Constraint concept"@en .


:ContinuousDelivery rdfs:comment "A software engineering practice in which code changes are kept ready for release through automated building, testing, and deployment processes."@en ;
                    rdfs:label "Continuous delivery"@en ;
                    <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Continuous_delivery> .


:ContinuousDeployment rdfs:comment "A software engineering practice in which code changes that pass automated validation are automatically released to production environments."@en ;
                      rdfs:label "Continuous deployment"@en ;
                      <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Continuous_deployment> .


:ContinuousIntegration rdfs:comment "A software engineering practice in which code changes are frequently integrated into a shared repository and automatically built and tested to detect integration problems early."@en ;
                       rdfs:label "Continuous integration"@en ;
                       <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Continuous_integration> .


:ControlConcept rdfs:comment "A primitive language concept that governs the flow or order of execution in a program, such as branching, iteration, recursion, sequencing, continuations, coroutines, or backtracking."@en ;
                rdfs:label "Control concept"@en .


:DataConcept rdfs:comment "A primitive language concept concerning the representation, organization, and manipulation of data, including data types and data structures."@en ;
             rdfs:label "Data concept"@en .


:DataModelDesign <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#DataDefinitionLanguage> ,
                                                                                 <http://www.softlang.org/ontologies/le#OntologyLanguage> ,
                                                                                 <http://www.softlang.org/ontologies/le#SemanticDataModelLanguage> ;
                 <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#DataManagementApproach> ;
                 rdfs:comment "An engineering design activity that defines the structure, relationships, constraints, and semantics of data to support its storage, management, and use."@en ;
                 rdfs:label "Data model design"@en ;
                 <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Data_model> .


:DependencyManagement rdfs:comment "An implementation activity concerned with declaring, resolving, updating, and maintaining the external software dependencies required by a project."@en ;
                      rdfs:label "Dependency management"@en ;
                      <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Package_manager> .


:Deployment rdfs:comment "Software engineering activity concerned with making a software system available for use in a target environment."@en ;
            rdfs:label "Deployment"@en ;
            <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_deployment> .


:DeploymentActivity rdfs:comment "An engineering activity concerned with delivering and deploying integrated software to target environments."@en ;
                    rdfs:label "Deployment activity"@en ;
                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_release_life_cycle> .


:DesignActivity rdfs:comment "A software engineering activity concerned with defining the structure, components, interfaces, and other characteristics of a software system or artifact."@en ;
                rdfs:label "Design activity"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_design> .


:DesignValidation rdfs:comment "Activity of evaluating a software design to determine whether it satisfies specified requirements and intended constraints."@en ;
                  rdfs:label "Design validation"@en ;
                  <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_design> .


:DevOpsPractice rdfs:comment "A support activity that integrates software development and IT operations practices to improve collaboration, automation, and the delivery and operation of software systems."@en ;
                rdfs:label "DevOps practice"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/DevOps> .


:Documentation rdfs:comment "Activity concerned with creating, maintaining, and managing documentation for software systems, languages, tools, or related artifacts."@en ;
               rdfs:label "Documentation"@en ;
               <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Documentation> .


:EffectConcept rdfs:comment "A primitive language concept that characterizes computational effects, such as state changes, input/output, exceptions, or other observable interactions beyond pure computation."@en ;
               rdfs:label "Effect concept"@en .


:EffortEstimation rdfs:comment "A planning and management activity that estimates the effort required to develop or maintain a software system."@en ;
                  rdfs:label "Effort estimation"@en ;
                  <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_development_effort_estimation> .


:EnvironmentProvisioning rdfs:comment "A support activity that provisions and configures the computing environments, infrastructure, and resources required for software development, deployment, or operation."@en ;
                         rdfs:label "Environment provisioning"@en ;
                         <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Provisioning> .


:ErrorHandlingConcept rdfs:comment "A primitive language concept concerning mechanisms for detecting, reporting, and recovering from errors or exceptional conditions during program execution."@en ;
                      rdfs:label "Error handling concept"@en .


:EvaluationStrategyConcept rdfs:comment "A primitive language concept that characterizes the rules governing when and how expressions or function arguments are evaluated."@en ;
                           rdfs:label "Evaluation strategy concept"@en .


:EvolutionActivity rdfs:comment "An engineering activity concerned with changing and maintaining a software system over its lifetime."@en ;
                   rdfs:label "Evolution activity"@en ;
                   <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_evolution> .


:Experimentation rdfs:comment "A support activity involving systematic experimentation to investigate, evaluate, or validate aspects of software languages, tools, or engineering processes."@en ;
                 rdfs:label "Experimentation"@en ;
                 <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Experiment> .


:FeatureEnhancement rdfs:comment "An evolution and improvement activity that adds or extends functionality in a software system."@en ;
                    rdfs:label "Feature enhancement"@en ;
                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_evolution> .


:FormalVerification <http://www.softlang.org/ontologies/tbox#hasInputArtifact> <http://www.softlang.org/ontologies/ae#ModelArtifact> ,
                                                                               <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
                    <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#ModelingLanguage> ,
                                                                                    <http://www.softlang.org/ontologies/le#ProofLanguage> ,
                                                                                    <http://www.softlang.org/ontologies/pe#ProgrammingLanguage> ;
                    <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#ProofAssistant> ;
                    <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#FormalSemanticsApproach> ,
                                                                   <http://www.softlang.org/ontologies/fe#ProgramLogic> ,
                                                                   <http://www.softlang.org/ontologies/fe#TypeTheory> ;
                    rdfs:comment "The engineering activity of establishing, through mathematically rigorous methods, that a model or program satisfies specified properties or requirements."@en ;
                    rdfs:label "Formal verification"@en ;
                    <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Formal_verification> .


:GovernanceActivity rdfs:comment "An engineering activity concerned with organizational oversight, compliance, accountability, or management of software-related concerns."@en ;
                    rdfs:label "Governance activity"@en .


:GrammarConcept rdfs:comment "A language concept concerning grammars, i.e., formal systems of production rules used to define the structure or syntax of a language."@en ;
                rdfs:label "Grammar concept"@en .


:HighLevelDesign rdfs:comment "A design activity that defines the overall architecture, major components, and high-level structure of a software system."@en ;
                 rdfs:label "High-level design"@en ;
                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_design> .


:HigherOrderConcept rdfs:comment "A primitive language concept concerning entities that can operate on, abstract over, or be parameterized by other entities of the same kind, such as functions, modules, or types."@en ;
                    rdfs:label "Higher-order concept"@en .


:Implementation <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/pe#ProgrammingLanguage> ;
                <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#Compiler> ,
                                                                            <http://www.softlang.org/ontologies/te#Interpreter> ;
                <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#SoftwareDesignApproach> ;
                rdfs:comment "An engineering activity that realizes a software design by producing an executable program using programming languages and supporting tools such as compilers or interpreters."@en ;
                rdfs:label "Implementation"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Implementation> .


:ImplementationActivity rdfs:comment "A software engineering activity concerned with implementing software artifacts, including programming, build scripting, dependency management, code review, and refactoring."@en ;
                        rdfs:label "Implementation activity"@en ;
                        <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Implementation> .


:ImprovementActivity rdfs:comment "An engineering activity intended to improve the quality, capabilities, maintainability, or other characteristics of a software system."@en ;
                     rdfs:label "Improvement activity"@en .


:IncidentManagement rdfs:comment "Software engineering activity concerned with managing the lifecycle of incidents, including their identification, logging, resolution, and closure."@en ;
                    rdfs:label "Incident management"@en ;
                    <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Incident_management> .


:IntegrationTesting rdfs:comment "A software testing activity that evaluates the interactions and interfaces among integrated software components or subsystems."@en ;
                    rdfs:label "Integration testing"@en ;
                    <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Integration_testing> .


:InterfaceDesign <http://www.softlang.org/ontologies/tbox#hasOutputArtifact> <http://www.softlang.org/ontologies/ae#APIDescriptionArtifact> ;
                 <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#InterfaceDescriptionLanguage> ;
                 <http://www.softlang.org/ontologies/tbox#hasSupportingTool> <http://www.softlang.org/ontologies/te#APIWorkbench> ;
                 <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#SoftwareDesignApproach> ;
                 rdfs:comment "Engineering activity concerned with defining the interfaces through which software components, systems, or services interact."@en ;
                 rdfs:label "Interface design"@en ;
                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Interface_(computing)> .


:KnowledgeManagement rdfs:comment "A support activity concerned with creating, organizing, sharing, and maintaining knowledge within an organization or project."@en ;
                     rdfs:label "Knowledge management"@en ;
                     <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Knowledge_management> .


:KnowledgeRepresentationConcept rdfs:comment "A language concept concerning the representation of knowledge in a form that enables its organization, sharing, querying, and reasoning."@en ;
                                rdfs:label "Knowledge-representation concept"@en .


:LifetimeConcept rdfs:comment "A primitive language concept concerning the period during which a program object or allocated memory remains valid and available for use."@en ;
                 rdfs:label "Lifetime concept"@en .


:Logging rdfs:comment "An operations and maintenance activity that records events, messages, and other runtime information produced by software systems."@en ;
         rdfs:label "Logging"@en ;
         <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Logging_(computing)> .


:LowLevelDesign rdfs:comment "The software design activity that specifies the detailed internal structure, components, interfaces, data structures, and algorithms needed to implement a system."@en ;
                rdfs:label "Low-level design"@en ;
                <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_design> .


:MaintenanceActivity rdfs:comment "An engineering activity concerned with modifying, correcting, adapting, or improving software after its delivery or deployment."@en ;
                     rdfs:label "Maintenance activity"@en ;
                     <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_maintenance> .


:ManagementActivity rdfs:comment "An engineering activity concerned with coordinating, allocating, controlling, and managing software-development resources, risks, configurations, or stakeholders."@en ;
                    rdfs:label "Management activity"@en ;
                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_project_management> .


:MetaprogrammingConcept rdfs:comment "A language concept concerning techniques in which programs generate, analyze, transform, or manipulate other programs or their own structure."@en ;
                        rdfs:label "Metaprogramming concept"@en .


:Migration rdfs:comment "An evolution and improvement activity that transitions software systems, applications, data, or platforms from one environment, technology, or version to another."@en ;
           rdfs:label "Migration"@en ;
           <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Migration_(software)> .


:ModelingConcept rdfs:comment "A language concept concerning the representation, construction, and use of models to describe systems, their structure, behavior, or other relevant aspects."@en ;
                 rdfs:label "Modeling concept"@en .


:ModularityConcept rdfs:comment "A primitive language concept concerned with decomposing a software system into separate, cohesive, and independently manageable parts, such as modules, packages, namespaces, interfaces, and contracts."@en ;
                   rdfs:label "Modularity concept"@en .


:Monitoring rdfs:comment "An operations and maintenance activity that observes a software system and its execution to assess its status, behavior, performance, and availability."@en ;
            rdfs:label "Monitoring"@en ;
            <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/System_monitoring> .


:MutabilityConcept rdfs:comment "A primitive language concept concerning whether data or program state can be modified after it is created, including mutable and immutable data and reference and value semantics."@en ;
                   rdfs:label "Mutability concept"@en .


:Onboarding rdfs:comment "A support activity that helps new users or stakeholders become familiar with a software language, tool, or related artifact."@en ;
            rdfs:label "Onboarding"@en ;
            <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Onboarding> .


:OperationsActivity rdfs:comment "An engineering activity concerned with operating, administering, monitoring, and managing deployed software systems and their supporting infrastructure."@en ;
                    rdfs:label "Operations activity"@en .


:Packaging rdfs:comment "A release and deployment activity that prepares software and its dependencies for distribution and installation."@en ;
           rdfs:label "Packaging"@en ;
           <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_packaging> .


:ParadigmConcept rdfs:comment "A primitive language concept that characterizes a fundamental programming paradigm or evaluation model, such as declarative, imperative, functional, logic, or object-oriented programming."@en ;
                 rdfs:label "Paradigm concept"@en .


:ParallelismConcept rdfs:comment "A primitive language concept concerning the simultaneous execution of multiple computations or tasks."@en ;
                    rdfs:label "Parallelism concept"@en .


:Patching rdfs:comment "Software engineering activity concerned with applying patches to software to correct defects, address security vulnerabilities, or make minor updates."@en ;
          rdfs:label "Patching"@en ;
          <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Patch_(computing)> .


:PerformanceTesting rdfs:comment "A validation testing activity that evaluates a software system's responsiveness, throughput, scalability, stability, and resource utilization under a specified workload."@en ;
                    rdfs:label "Performance testing"@en ;
                    <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Performance_testing> .


:PerformanceTuning rdfs:comment "An operations and maintenance activity that improves a software system's performance by identifying and addressing performance bottlenecks."@en ;
                   rdfs:label "Performance tuning"@en ;
                   <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Performance_testing> .


:PlanningActivity rdfs:comment "An engineering activity concerned with establishing objectives, plans, estimates, roadmaps, or processes for software development."@en ;
                  rdfs:label "Planning activity"@en .


:PrimitiveConcept rdfs:comment "A general category for fundamental software-language concepts, including abstractions, bindings, control, data, types, scope, state, and related notions."@en ;
                  rdfs:label "Primitive concept"@en .


:ProcessDefinition rdfs:comment "An engineering activity that defines, documents, and establishes the process by which software is developed, managed, and maintained."@en ;
                   rdfs:label "Process definition"@en ;
                   <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_development_process> .


