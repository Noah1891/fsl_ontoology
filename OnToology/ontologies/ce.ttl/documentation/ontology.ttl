             rdfs:label "Prototyping"@en ;
             <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_prototyping> .


:QualityActivity rdfs:comment "An engineering activity concerned with assuring, controlling, or improving software quality."@en ;
                 rdfs:label "Quality activity"@en ;
                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_quality> .


:QualityAssurance rdfs:comment "An engineering activity concerned with ensuring that software products and development processes meet specified quality requirements and standards."@en ;
                  rdfs:label "Quality assurance"@en ;
                  <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Quality_assurance> .


:QualityControl rdfs:comment "Activity concerned with monitoring and evaluating software products and development processes to ensure that they meet defined quality requirements and standards."@en ;
                rdfs:label "Quality control"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Quality_control> .


:QueryConcept rdfs:comment "A language concept concerned with expressing requests for, selecting, navigating, or retrieving information from an artifact or data source."@en ;
              rdfs:label "Query concept"@en .


:Recovery rdfs:comment "An operations and maintenance activity that restores data or system state after loss, damage, or failure."@en ;
          rdfs:label "Recovery"@en ;
          <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Data_recovery> .


:Reengineering rdfs:comment "An evolution and improvement activity that analyzes, restructures, or transforms an existing software system to improve its maintainability, quality, or adaptability while preserving its functionality."@en ;
               rdfs:label "Re-engineering"@en ;
               <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Reengineering> .


:Refactoring <http://www.softlang.org/ontologies/tbox#hasAffectedArtifact> <http://www.softlang.org/ontologies/ae#ProgramArtifact> ;
