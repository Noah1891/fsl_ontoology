                rdfs:comment "An engineering activity that analyzes a program without executing it to detect defects, verify properties, or derive information about its behavior."@en ;
                rdfs:label "Static analysis"@en ;
                <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Static_program_analysis> .


:StructuredComputationConcept rdfs:comment "A language concept for structuring and composing computations, including applicative, arrow, continuation-passing, effect-handler, monadic, and pipeline styles."@en ;
                              rdfs:label "Structured computation concept"@en .


:SupportActivity rdfs:comment "A software engineering activity that provides supporting capabilities, resources, or services for other development activities rather than directly producing a software artifact."@en ;
                 rdfs:label "Support activity"@en ;
                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Systems_development_life_cycle> .


:SystemArchitectureDesign <http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> <http://www.softlang.org/ontologies/le#ModelingLanguage> ;
                          <http://www.softlang.org/ontologies/tbox#uses> <http://www.softlang.org/ontologies/fe#SoftwareDesignApproach> ;
                          rdfs:comment "Design activity concerned with defining the high-level structure, components, interfaces, and relationships of a software system."@en ;
                          rdfs:label "System architecture design"@en ;
                          <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_architecture> .


:SystemTesting rdfs:comment "A validation testing activity that evaluates a complete, integrated software system to determine whether it satisfies its specified requirements."@en ;
               rdfs:label "System testing"@en ;
               <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/System_testing> .


:TechnicalDebtManagement rdfs:comment "An engineering activity concerned with identifying, assessing, prioritizing, and reducing technical debt in software systems."@en ;
                         rdfs:label "Technical debt management"@en ;
                         <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Technical_debt> .


:TestingActivity rdfs:comment "An engineering activity that evaluates software or related artifacts by executing or otherwise examining them to identify defects and assess whether they satisfy specified requirements."@en ;
                 rdfs:label "Testing activity"@en ;
                 <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_testing> .


:ToolingSetup rdfs:comment "A support activity concerned with configuring, installing, and maintaining the software tools required for development or other engineering work."@en ;
              rdfs:label "Tooling setup"@en ;
              <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_tool> .


:Training rdfs:comment "A support activity that develops users' or stakeholders' knowledge and skills for using a software language, tool, or related artifact."@en ;
          rdfs:label "Training"@en .


:TransformationConcept rdfs:comment "A language concept concerning the specification or execution of transformations that map one software artifact, model, document, or program representation to another."@en ;
                       rdfs:label "Transformation concept"@en .


:TypeConcept rdfs:comment "A primitive language concept concerning types and type systems, including typing disciplines, polymorphism, subtyping, and type inference."@en ;
             rdfs:label "Type concept"@en .


:UXUIDesign rdfs:comment "A design activity concerned with shaping the user experience and user interface of a software system."@en ;
            rdfs:label "UX/UI design"@en ;
            <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/User_experience_design> ,
                                             <https://en.wikipedia.org/wiki/User_interface_design> .


:UnitTesting rdfs:comment "A verification testing activity in which individual software units, such as functions, classes, or modules, are tested in isolation to determine whether they satisfy their specified behavior."@en ;
             rdfs:label "Unit testing"@en ;
             <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Unit_testing> .


:UsabilityTesting rdfs:comment "A validation testing activity that evaluates how effectively, efficiently, and satisfactorily intended users can use a software system to achieve specified goals."@en ;
                  rdfs:label "Usability testing"@en ;
                  <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Usability_testing> .


:UserAcceptanceTesting rdfs:comment "An acceptance testing activity in which intended end users evaluate whether a system satisfies their needs and acceptance criteria."@en ;
                       rdfs:label "User acceptance testing"@en ;
                       <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Acceptance_testing> .


:ValidationActivity rdfs:comment "An engineering activity that determines whether a software system, artifact, or language-based solution satisfies its intended requirements and stakeholder needs."@en ;
                    rdfs:label "Validation activity"@en ;
                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Verification_and_validation> .


:ValidationActivityCategory rdfs:comment "An engineering-activity category concerned with determining whether a software artifact fulfills its intended use and stakeholder needs."@en ;
                            rdfs:label "Validation activity category"@en ;
                            <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Verification_and_validation> .


:ValidationTestingActivity rdfs:comment "A testing activity that evaluates whether a software system satisfies its intended use, stakeholder needs, and specified requirements."@en ;
                           rdfs:label "Validation testing activity"@en ;
                           <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_testing> .


:VerificationActivity rdfs:comment "A software engineering activity that assesses whether a software artifact satisfies its specified requirements or properties."@en ;
                      rdfs:label "Verification activity"@en ;
                      <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Verification_and_validation> .


:VerificationActivityCategory rdfs:comment "An engineering-activity category concerned with determining whether a software artifact conforms to its specified requirements."@en ;
                              rdfs:label "Verification activity category"@en ;
                              <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Verification_and_validation> .


:VerificationTestingActivity rdfs:comment "An engineering activity that verifies software through testing, including unit and integration testing."@en ;
                             rdfs:label "Verification testing activity"@en ;
                             <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Software_testing> .


:Versioning rdfs:comment "An engineering activity concerned with assigning and managing version identifiers for software artifacts and releases over time."@en ;
            rdfs:label "Versioning"@en ;
            <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Software_versioning> .


