@prefix : <http://www.softlang.org/ontologies/fsl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.softlang.org/ontologies/fsl#> .

<http://www.softlang.org/ontologies/fsl> rdf:type owl:Ontology ;
                                          <http://www.softlang.org/ontologies/tbox#commentingPolicy> "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
                                          <http://www.softlang.org/ontologies/tbox#formattingPolicy> "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
                                          <http://www.softlang.org/ontologies/tbox#linkingPolicy> "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
                                          <http://www.softlang.org/ontologies/tbox#metamodelingPolicy> "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
                                          rdfs:comment "Ontology on the foundations of software languages"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.softlang.org/ontologies/pe#profilingPolicy
<http://www.softlang.org/ontologies/pe#profilingPolicy> rdf:type owl:AnnotationProperty ;
                                                        rdfs:label "profiling policy"@en .


###  http://www.softlang.org/ontologies/tbox#commentingPolicy
<http://www.softlang.org/ontologies/tbox#commentingPolicy> rdf:type owl:AnnotationProperty .


###  http://www.softlang.org/ontologies/tbox#formattingPolicy
<http://www.softlang.org/ontologies/tbox#formattingPolicy> rdf:type owl:AnnotationProperty .


###  http://www.softlang.org/ontologies/tbox#linkingPolicy
<http://www.softlang.org/ontologies/tbox#linkingPolicy> rdf:type owl:AnnotationProperty .


###  http://www.softlang.org/ontologies/tbox#metamodelingPolicy
<http://www.softlang.org/ontologies/tbox#metamodelingPolicy> rdf:type owl:AnnotationProperty .


###  http://www.softlang.org/ontologies/tbox#object
<http://www.softlang.org/ontologies/tbox#object> rdf:type owl:AnnotationProperty ;
                                                 rdfs:comment "Identifies the object constituent of an issue when the issue concerns a particular assertion; this property designates object role rather than the overall issue target"@en ;
                                                 rdfs:label "object"@en ;
                                                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
                                                 rdfs:subPropertyOf rdf:object ;
                                                 rdfs:domain <http://www.softlang.org/ontologies/tbox#IssueEntity> .


###  http://www.softlang.org/ontologies/tbox#predicate
<http://www.softlang.org/ontologies/tbox#predicate> rdf:type owl:AnnotationProperty ;
                                                    rdfs:comment "Identifies the predicate constituent of an issue when the issue concerns a particular assertion; this property designates predicate role rather than the overall issue target"@en ;
                                                    rdfs:label "predicate"@en ;
                                                    <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
                                                    rdfs:subPropertyOf rdf:predicate ;
                                                    rdfs:domain <http://www.softlang.org/ontologies/tbox#IssueEntity> .


###  http://www.softlang.org/ontologies/tbox#subject
<http://www.softlang.org/ontologies/tbox#subject> rdf:type owl:AnnotationProperty ;
                                                  rdfs:comment "Identifies the subject constituent of an issue when the issue concerns a particular assertion; this property designates subject role rather than the overall issue target"@en ;
                                                  rdfs:label "subject"@en ;
                                                  <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
                                                  rdfs:subPropertyOf rdf:subject ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#IssueEntity> .


###  http://www.softlang.org/ontologies/tbox#target
<http://www.softlang.org/ontologies/tbox#target> rdf:type owl:AnnotationProperty ;
                                                 rdfs:comment "Identifies the primary resource that an issue is about, such as a reviewed resource or an ontology/module addressed as a whole; assertion-level issues are instead designated through subject, predicate, and object"@en ;
                                                 rdfs:label "target"@en ;
                                                 <http://xmlns.com/foaf/0.1/page> <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
                                                 rdfs:domain <http://www.softlang.org/ontologies/tbox#IssueEntity> .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#object
rdf:object rdf:type owl:AnnotationProperty .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#predicate
rdf:predicate rdf:type owl:AnnotationProperty .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#subject
rdf:subject rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
<http://www.w3.org/2004/02/skos/core#note> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.softlang.org/ontologies/tbox#assertedForConcept
<http://www.softlang.org/ontologies/tbox#assertedForConcept> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageSupportAssertion> ;
                                                             rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#assertedForLanguage
<http://www.softlang.org/ontologies/tbox#assertedForLanguage> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageSupportAssertion> ;
                                                              rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageEntity> .


###  http://www.softlang.org/ontologies/tbox#classifies
<http://www.softlang.org/ontologies/tbox#classifies> rdf:type owl:ObjectProperty ;
                                                     owl:inverseOf <http://www.softlang.org/ontologies/tbox#conformsTo> ;
                                                     rdfs:domain <http://www.softlang.org/ontologies/tbox#ArtifactEntity> ;
                                                     rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#conformsTo
<http://www.softlang.org/ontologies/tbox#conformsTo> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.softlang.org/ontologies/tbox#ArtifactEntity> ;
                                                     rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#defines
<http://www.softlang.org/ontologies/tbox#defines> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <http://www.softlang.org/ontologies/tbox#isDefinedBy> ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#ArtifactEntity> ;
                                                  rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageEntity> .


###  http://www.softlang.org/ontologies/tbox#elementOf
<http://www.softlang.org/ontologies/tbox#elementOf> rdf:type owl:ObjectProperty ;
                                                    owl:inverseOf <http://www.softlang.org/ontologies/tbox#hasElement> ;
                                                    rdfs:domain <http://www.softlang.org/ontologies/tbox#ArtifactEntity> ;
                                                    rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageEntity> .


###  http://www.softlang.org/ontologies/tbox#extends
<http://www.softlang.org/ontologies/tbox#extends> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <http://www.softlang.org/ontologies/tbox#isExtendedBy> ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#SoftwareLanguage> ;
                                                  rdfs:range <http://www.softlang.org/ontologies/tbox#SoftwareLanguage> .


###  http://www.softlang.org/ontologies/tbox#hasAffectedArtifact
<http://www.softlang.org/ontologies/tbox#hasAffectedArtifact> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain [ rdf:type owl:Class ;
                                                                            owl:unionOf ( <http://www.softlang.org/ontologies/tbox#EngineeringActivity>
                                                                                          <http://www.softlang.org/ontologies/tbox#ToolEntity>
                                                                                        )
                                                                          ] ;
                                                              rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#hasApplicability
<http://www.softlang.org/ontologies/tbox#hasApplicability> rdf:type owl:ObjectProperty ;
                                                           rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageSupportAssertion> ;
                                                           rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConceptApplicability> .


###  http://www.softlang.org/ontologies/tbox#hasArea
<http://www.softlang.org/ontologies/tbox#hasArea> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <http://www.softlang.org/ontologies/tbox#isAreaOf> ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                  rdfs:range <http://www.softlang.org/ontologies/tbox#SubjectArea> .


###  http://www.softlang.org/ontologies/tbox#hasArtifact
<http://www.softlang.org/ontologies/tbox#hasArtifact> rdf:type owl:ObjectProperty ;
                                                      owl:inverseOf <http://www.softlang.org/ontologies/tbox#isArtifactOf> ;
                                                      rdfs:domain <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> ;
                                                      rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#hasComponent
<http://www.softlang.org/ontologies/tbox#hasComponent> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://www.softlang.org/ontologies/tbox#CompositeConcept> ;
                                                       rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#hasDominantForm
<http://www.softlang.org/ontologies/tbox#hasDominantForm> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageSupportAssertion> ;
                                                          rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#hasElement
<http://www.softlang.org/ontologies/tbox#hasElement> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageEntity> ;
                                                     rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#hasInputArtifact
<http://www.softlang.org/ontologies/tbox#hasInputArtifact> rdf:type owl:ObjectProperty ;
                                                           rdfs:domain [ rdf:type owl:Class ;
                                                                         owl:unionOf ( <http://www.softlang.org/ontologies/tbox#EngineeringActivity>
                                                                                       <http://www.softlang.org/ontologies/tbox#ToolEntity>
                                                                                     )
                                                                       ] ;
                                                           rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#hasOutputArtifact
<http://www.softlang.org/ontologies/tbox#hasOutputArtifact> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain [ rdf:type owl:Class ;
                                                                          owl:unionOf ( <http://www.softlang.org/ontologies/tbox#EngineeringActivity>
                                                                                        <http://www.softlang.org/ontologies/tbox#ToolEntity>
                                                                                      )
                                                                        ] ;
                                                            rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#hasPart
<http://www.softlang.org/ontologies/tbox#hasPart> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://www.softlang.org/ontologies/tbox#uses> ;
                                                  owl:inverseOf <http://www.softlang.org/ontologies/tbox#isPartOf> ;
                                                  rdf:type owl:AsymmetricProperty ,
                                                           owl:IrreflexiveProperty ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                  rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                  rdfs:comment "Relates an ontology entity to another ontology entity that is a structural part or constituent of it"@en ;
                                                  rdfs:label "has part"@en ;
                                                  <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Mereology> .


###  http://www.softlang.org/ontologies/tbox#hasPrimaryComponent
<http://www.softlang.org/ontologies/tbox#hasPrimaryComponent> rdf:type owl:ObjectProperty ;
                                                              rdfs:subPropertyOf <http://www.softlang.org/ontologies/tbox#hasComponent> ;
                                                              rdfs:domain <http://www.softlang.org/ontologies/tbox#CompositeConcept> ;
                                                              rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#hasPrimaryMechanism
<http://www.softlang.org/ontologies/tbox#hasPrimaryMechanism> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageSupportAssertion> ;
                                                              rdfs:range <http://www.softlang.org/ontologies/tbox#ImplementationMechanismConcept> .


###  http://www.softlang.org/ontologies/tbox#hasSecondaryComponent
<http://www.softlang.org/ontologies/tbox#hasSecondaryComponent> rdf:type owl:ObjectProperty ;
                                                                rdfs:subPropertyOf <http://www.softlang.org/ontologies/tbox#hasComponent> ;
                                                                rdfs:domain <http://www.softlang.org/ontologies/tbox#CompositeConcept> ;
                                                                rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#hasSpace
<http://www.softlang.org/ontologies/tbox#hasSpace> rdf:type owl:ObjectProperty ;
                                                   owl:inverseOf <http://www.softlang.org/ontologies/tbox#isSpaceOf> ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                   rdfs:range <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> .


###  http://www.softlang.org/ontologies/tbox#hasSupportKind
<http://www.softlang.org/ontologies/tbox#hasSupportKind> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageSupportAssertion> ;
                                                         rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageSupportKind> .


###  http://www.softlang.org/ontologies/tbox#hasSupportingLanguage
<http://www.softlang.org/ontologies/tbox#hasSupportingLanguage> rdf:type owl:ObjectProperty ;
                                                                rdfs:domain <http://www.softlang.org/ontologies/tbox#EngineeringActivity> ;
                                                                rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageEntity> .


###  http://www.softlang.org/ontologies/tbox#hasSupportingTool
<http://www.softlang.org/ontologies/tbox#hasSupportingTool> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://www.softlang.org/ontologies/tbox#EngineeringActivity> ;
                                                            rdfs:range <http://www.softlang.org/ontologies/tbox#ToolEntity> .


###  http://www.softlang.org/ontologies/tbox#hasTool
<http://www.softlang.org/ontologies/tbox#hasTool> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <http://www.softlang.org/ontologies/tbox#isToolOf> ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> ;
                                                  rdfs:range <http://www.softlang.org/ontologies/tbox#ToolEntity> .


###  http://www.softlang.org/ontologies/tbox#isAreaOf
<http://www.softlang.org/ontologies/tbox#isAreaOf> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#SubjectArea> ;
                                                   rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> .


###  http://www.softlang.org/ontologies/tbox#isArtifactOf
<http://www.softlang.org/ontologies/tbox#isArtifactOf> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://www.softlang.org/ontologies/tbox#ArtifactEntity> ;
                                                       rdfs:range <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> .


###  http://www.softlang.org/ontologies/tbox#isDefinedBy
<http://www.softlang.org/ontologies/tbox#isDefinedBy> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageEntity> ;
                                                      rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#isExtendedBy
<http://www.softlang.org/ontologies/tbox#isExtendedBy> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://www.softlang.org/ontologies/tbox#SoftwareLanguage> ;
                                                       rdfs:range <http://www.softlang.org/ontologies/tbox#SoftwareLanguage> .


###  http://www.softlang.org/ontologies/tbox#isPartOf
<http://www.softlang.org/ontologies/tbox#isPartOf> rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf <http://www.softlang.org/ontologies/tbox#isUsedBy> ;
                                                   rdf:type owl:AsymmetricProperty ,
                                                            owl:IrreflexiveProperty ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                   rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                   rdfs:comment "Relates an ontology entity to another ontology entity of which it is a structural part or constituent"@en ;
                                                   rdfs:label "is part of"@en ;
                                                   <http://xmlns.com/foaf/0.1/isPrimaryTopicOf> <https://en.wikipedia.org/wiki/Mereology> .


###  http://www.softlang.org/ontologies/tbox#isProcessedBy
<http://www.softlang.org/ontologies/tbox#isProcessedBy> rdf:type owl:ObjectProperty ;
                                                        owl:inverseOf <http://www.softlang.org/ontologies/tbox#processes> ;
                                                        rdfs:domain <http://www.softlang.org/ontologies/tbox#ArtifactEntity> ;
                                                        rdfs:range <http://www.softlang.org/ontologies/tbox#ToolEntity> .


###  http://www.softlang.org/ontologies/tbox#isServedBy
<http://www.softlang.org/ontologies/tbox#isServedBy> rdf:type owl:ObjectProperty ;
                                                     owl:inverseOf <http://www.softlang.org/ontologies/tbox#serves> ;
                                                     rdfs:domain <http://www.softlang.org/ontologies/tbox#MethodologicalApproach> ;
                                                     rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> .


###  http://www.softlang.org/ontologies/tbox#isSpaceOf
<http://www.softlang.org/ontologies/tbox#isSpaceOf> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> ;
                                                    rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> .


###  http://www.softlang.org/ontologies/tbox#isSpecifiedBy
<http://www.softlang.org/ontologies/tbox#isSpecifiedBy> rdf:type owl:ObjectProperty ;
                                                        owl:inverseOf <http://www.softlang.org/ontologies/tbox#specifies> ;
                                                        rdfs:domain <http://www.softlang.org/ontologies/tbox#FormalEntity> ;
                                                        rdfs:range <http://www.softlang.org/ontologies/tbox#MethodologicalApproach> .


###  http://www.softlang.org/ontologies/tbox#isTargetedBy
<http://www.softlang.org/ontologies/tbox#isTargetedBy> rdf:type owl:ObjectProperty ;
                                                       owl:inverseOf <http://www.softlang.org/ontologies/tbox#targets> ;
                                                       rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageEntity> ;
                                                       rdfs:range <http://www.softlang.org/ontologies/tbox#ToolEntity> .


###  http://www.softlang.org/ontologies/tbox#isToolOf
<http://www.softlang.org/ontologies/tbox#isToolOf> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#ToolEntity> ;
                                                   rdfs:range <http://www.softlang.org/ontologies/tbox#TechnologicalSpace> .


###  http://www.softlang.org/ontologies/tbox#isUsedBy
<http://www.softlang.org/ontologies/tbox#isUsedBy> rdf:type owl:ObjectProperty ;
                                                   owl:inverseOf <http://www.softlang.org/ontologies/tbox#uses> ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                   rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> .


###  http://www.softlang.org/ontologies/tbox#nativelySupports
<http://www.softlang.org/ontologies/tbox#nativelySupports> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf <http://www.softlang.org/ontologies/tbox#supports> ;
                                                           rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageEntity> ;
                                                           rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#processes
<http://www.softlang.org/ontologies/tbox#processes> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.softlang.org/ontologies/tbox#ToolEntity> ;
                                                    rdfs:range <http://www.softlang.org/ontologies/tbox#ArtifactEntity> .


###  http://www.softlang.org/ontologies/tbox#resolveAfter
<http://www.softlang.org/ontologies/tbox#resolveAfter> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://www.softlang.org/ontologies/tbox#IssueEntity> ;
                                                       rdfs:range <http://www.softlang.org/ontologies/tbox#IssueEntity> .


###  http://www.softlang.org/ontologies/tbox#serves
<http://www.softlang.org/ontologies/tbox#serves> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                 rdfs:range <http://www.softlang.org/ontologies/tbox#MethodologicalApproach> .


###  http://www.softlang.org/ontologies/tbox#specifies
<http://www.softlang.org/ontologies/tbox#specifies> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.softlang.org/ontologies/tbox#MethodologicalApproach> ;
                                                    rdfs:range <http://www.softlang.org/ontologies/tbox#FormalEntity> .


###  http://www.softlang.org/ontologies/tbox#standardlySupports
<http://www.softlang.org/ontologies/tbox#standardlySupports> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf <http://www.softlang.org/ontologies/tbox#supports> ;
                                                             rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageEntity> ;
                                                             rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#supports
<http://www.softlang.org/ontologies/tbox#supports> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#LanguageEntity> ;
                                                   rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageConcept> .


###  http://www.softlang.org/ontologies/tbox#targets
<http://www.softlang.org/ontologies/tbox#targets> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.softlang.org/ontologies/tbox#ToolEntity> ;
                                                  rdfs:range <http://www.softlang.org/ontologies/tbox#LanguageEntity> .


###  http://www.softlang.org/ontologies/tbox#uses
<http://www.softlang.org/ontologies/tbox#uses> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                               rdfs:range <http://www.softlang.org/ontologies/tbox#Entity> .


#################################################################
#    Data properties
#################################################################

###  http://www.softlang.org/ontologies/tbox#critique
<http://www.softlang.org/ontologies/tbox#critique> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain <http://www.softlang.org/ontologies/tbox#IssueEntity> ;
                                                   rdfs:range rdf:langString .


###  http://www.softlang.org/ontologies/tbox#hasBibTeX
<http://www.softlang.org/ontologies/tbox#hasBibTeX> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.softlang.org/ontologies/tbox#Entity> ;
                                                    rdfs:range xsd:string .


###  http://www.softlang.org/ontologies/tbox#suggestion
<http://www.softlang.org/ontologies/tbox#suggestion> rdf:type owl:DatatypeProperty ;
