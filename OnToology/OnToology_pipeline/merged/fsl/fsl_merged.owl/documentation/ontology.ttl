                                                       rdfs:subClassOf <http://www.softlang.org/ontologies/tbox#Entity> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.softlang.org/ontologies/tbox#hasArea> ;
                                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                         owl:onClass <http://www.softlang.org/ontologies/tbox#SubjectArea>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.softlang.org/ontologies/tbox#hasSpace> ;
                                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                         owl:onClass <http://www.softlang.org/ontologies/tbox#TechnologicalSpace>
                                                                       ] ;
                                                       <http://www.softlang.org/ontologies/tbox#metamodelingPolicy> "All non-immediate subclasses must also be of this type."@en ;
                                                       rdfs:comment "Ontological entity used to represent formal formalisms, theories, models of computation, and methodological approaches"@en ;
                                                       rdfs:label "Formal entity"@en .


