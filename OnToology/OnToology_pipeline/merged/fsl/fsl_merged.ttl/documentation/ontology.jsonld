    "@id" : "http://www.softlang.org/ontologies/tbox#ConceptualEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A software engineering activity concerned with eliciting, analyzing, specifying, validating, prioritizing, and managing system requirements."
