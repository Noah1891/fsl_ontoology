  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.softlang.org/ontologies/tbox#LanguageEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Concrete software languages (e.g., XML, SQL, OWL) are represented as individuals of this class. Language families are represented as subclasses. Artifact kinds capture the kinds of artifacts written in such languages."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Software language"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.softlang.org/ontologies/tbox#LanguageEntity"
  } ],
  "http://xmlns.com/foaf/0.1/page" : [ {
    "@id" : "https://en.wikipedia.org/wiki/Software_language"
  } ]
}, {
  "@id" : "http://www.softlang.org/ontologies/tbox#SoftwareTool",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.softlang.org/ontologies/tbox#ToolEntity"
