import argparse
import json
import re
from pathlib import Path

from rdflib import Graph


SCRIPT_DIR = Path(__file__).resolve().parent
ONTOLO_CI_DIR = SCRIPT_DIR.parent
RESEARCH_DIR = ONTOLO_CI_DIR.parent
REPO_ROOT = RESEARCH_DIR.parent

VALIDATION_DIR = REPO_ROOT / "validation"
ONTOLOGIES_DIR = REPO_ROOT / "ontologies"


SHACL_SYSTEM_INSTRUCTIONS = """You are an RDF/SHACL repair assistant.

Your task is to repair an RDF/Turtle ontology based on a detected SHACL
violation.

Return ONLY one JSON object matching the requested schema.

IMPORTANT RULES:

1. The SHACL shape is authoritative.
2. Do NOT modify the SHACL shape.
3. Repair the ontology/data instead.
4. Only make changes directly justified by the SHACL violation and the
   supplied ontology context.
5. Prefer the smallest safe repair.
6. Do not invent unrelated ontology changes.
7. If the violation cannot be safely repaired, set skip=true and return
   empty add and remove arrays.
8. Never disable, weaken, modify, or remove the SHACL constraint itself.
9. Never remove a required RDF triple merely because the SHACL constraint
   exists.
10. When a required property is missing, add the required property to the
    affected RDF resource if its value can be safely derived.
11. Preserve existing ontology meaning and terminology whenever possible.

RDF/TURTLE OUTPUT RULES:

12. Every item in add must be exactly ONE concrete RDF/Turtle triple.
13. Every item in remove must be exactly ONE concrete RDF/Turtle triple.
14. Every triple must end with a period.
15. Every triple must have a complete URI subject enclosed directly in
    angle brackets.
16. Every predicate must have a complete URI enclosed directly in angle
    brackets.
17. Do NOT use prefixed names such as rdfs:comment.
18. Do NOT use SPARQL variables such as ?c or ?value.
19. Do NOT use placeholders.
20. Do NOT use Markdown.
21. Do NOT use Markdown links.
22. Do NOT use square-bracket URI syntax.
23. Do NOT put parentheses around URIs.
24. Do NOT write hyperlinks.
25. The RDF URI itself must appear directly inside < and >.
26. A literal object may be a normal Turtle literal.
27. If adding an rdfs:comment, use the complete RDF URI for the
    rdfs:comment predicate.
28. Do not add a duplicate triple that already exists.
29. Do not remove a triple unless its removal is required to resolve the
    detected SHACL violation.
30. Never return explanatory text outside the JSON object.

For a missing rdfs:comment violation, the correct repair is normally to
ADD an rdfs:comment triple to the affected resource.

Do NOT remove the SHACL rule.
Do NOT remove the affected resource.
Do NOT remove unrelated RDF triples.

If a meaningful comment cannot be safely derived from the supplied
context, use skip=true.
"""


FULL_URI_TRIPLE_PATTERN = re.compile(
    r"^\s*<[^<>]+>\s+<[^<>]+>\s+.+\s+\.\s*$",
    re.DOTALL,
)


def validate_rdf_triple(value):
    if not isinstance(value, str):
        return False

    if not FULL_URI_TRIPLE_PATTERN.match(value):
        return False

    if "](" in value or "](http" in value:
        return False

    if "?" in value:
        return False

    graph = Graph()

    try:
        graph.parse(data=value, format="turtle")
    except Exception:
        return False

    return len(graph) == 1


def resolve_file(path_string, target_file=None):
    """
    Resolve a referenced file.

    Resolution order:

    1. Absolute path supplied by the violation record.
    2. Current working directory.
    3. Repository root.
    4. ontologies/
    5. validation/
    6. /tmp/
    7. If target_file is supplied, search /tmp recursively for its basename.
    """

    if not path_string:
        return None

    path = Path(path_string).expanduser()

    if path.is_absolute() and path.is_file():
        return path

    candidates = [
        Path.cwd() / path,
        REPO_ROOT / path,
        ONTOLOGIES_DIR / path,
        VALIDATION_DIR / path,
        Path("/tmp") / path,
    ]

    for candidate in candidates:
        if candidate.is_file():
            return candidate.resolve()

    if target_file:
        target_name = Path(target_file).name

        tmp_root = Path("/tmp")

        if tmp_root.exists():
            try:
                matches = list(tmp_root.rglob(target_name))
            except Exception:
                matches = []

            for match in matches:
                if match.is_file():
                    return match.resolve()

    return None


def read_text_file(path):
    if path is None:
        return ""

    try:
        return path.read_text(encoding="utf-8")
    except Exception:
        return ""


def read_turtle(path):
    if path is None or not path.is_file():
        return ""

    try:
        graph = Graph()
        graph.parse(path, format="turtle")

        return graph.serialize(format="turtle")
    except Exception:
        return read_text_file(path)


def read_shacl_shape(shape_path):
    return read_text_file(shape_path)


def build_context(target_path, focus_node):
    """
    Build ontology context around the affected resource.

    The full ontology is included so the LLM has enough information to
    derive a safe repair. If the ontology is large, the context is still
    bounded by the surrounding resource information where possible.
    """

    if target_path is None:
        return "Ontology context:\n```turtle\n\n```"

    try:
        graph = Graph()
        graph.parse(target_path, format="turtle")
    except Exception:
        text = read_text_file(target_path)

        return (
            "Ontology context:\n"
            "```turtle\n"
            + text
            + "\n```"
        )

    focus_uri = None

    if focus_node:
        try:
            focus_uri = next(
                (
                    subject
                    for subject in graph.all_nodes()
                    if str(subject) == focus_node
                ),
                None,
            )
        except Exception:
            focus_uri = None

    context_graph = Graph()

    if focus_uri is not None:
        for triple in graph.triples((focus_uri, None, None)):
            context_graph.add(triple)

        for triple in graph.triples((None, None, focus_uri)):
            context_graph.add(triple)

    # If no focus-specific triples were found, include the complete graph.
    if len(context_graph) == 0:
        context_graph = graph

    context_text = context_graph.serialize(format="turtle")

    return (
        "Ontology context:\n"
        "```turtle\n"
        + context_text
        + "\n```"
    )


def build_single_request(record, index):
    focus_node = record.get("focus_node", "")
    message = record.get("message", "")
    shape_reference = record.get("shape", "")
    data_file = record.get("data_file", "")

    shape_path = resolve_file(shape_reference)

    if shape_path is None:
        shape_text = (
            "# SHACL shape could not be resolved locally.\n"
            "# Shape reference: "
            + str(shape_reference)
        )
    else:
        shape_text = read_shacl_shape(shape_path)

    target_path = resolve_file(
        data_file,
        target_file=data_file,
    )

    context = build_context(
        target_path,
        focus_node,
    )

    user_input_parts = [
        "SHACL violation:",
        "",
        "Focus node:",
        focus_node,
        "",
        "Violation message:",
        message,
        "",
        "SHACL shape that MUST remain unchanged:",
        "```turtle",
        shape_text,
        "```",
        "",
        "Target ontology file:",
        data_file,
        "",
        context,
        "",
        "Determine the smallest safe RDF/Turtle repair that resolves "
        "this SHACL violation.",
        "",
        "Return ONLY the requested JSON object.",
    ]

    user_input = "\n".join(user_input_parts)

    request = {
        "custom_id": f"shacl-repair-{index}",
        "method": "POST",
        "url": "/v1/chat/completions",
        "body": {
            "model": "gpt-4.1-nano",
            "temperature": 0,
            "response_format": {
                "type": "json_schema",
                "json_schema": {
                    "name": "shacl_repair",
                    "strict": True,
                    "schema": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "add": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "pattern": (
                                        r"^<[^<>]+>\s+<[^<>]+>\s+.+\s+\.$"
                                    ),
                                },
                            },
                            "remove": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "pattern": (
                                        r"^<[^<>]+>\s+<[^<>]+>\s+.+\s+\.$"
                                    ),
                                },
                            },
                            "explanation": {
                                "type": "string",
                            },
                            "skip": {
                                "type": "boolean",
                            },
                        },
                        "required": [
                            "add",
                            "remove",
                            "explanation",
                            "skip",
                        ],
                    },
                },
            },
            "messages": [
                {
                    "role": "system",
                    "content": SHACL_SYSTEM_INSTRUCTIONS,
                },
                {
                    "role": "user",
                    "content": user_input,
                },
            ],
        },
    }

    return request


def build_batch_requests(records, output_path):
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    requests = []

    for index, record in enumerate(records, start=1):
        requests.append(
            build_single_request(
                record,
                index,
            )
        )

    with output_path.open("w", encoding="utf-8") as handle:
        for request in requests:
            handle.write(
                json.dumps(
                    request,
                    ensure_ascii=False,
                )
                + "\n"
            )

    return len(requests)


def load_violations(input_path):
    input_path = Path(input_path)

    with input_path.open("r", encoding="utf-8") as handle:
        data = json.load(handle)

    if isinstance(data, dict):
        if "violations" in data:
            data = data["violations"]
        else:
            data = [data]

    if not isinstance(data, list):
        raise ValueError("Violation input must be a JSON array.")

    return data


def main():
    parser = argparse.ArgumentParser(
        description="Build OpenAI batch requests for SHACL violations."
    )

    parser.add_argument(
        "--input",
        required=True,
        help="JSON file containing SHACL violation records.",
    )

    parser.add_argument(
        "--output",
        required=True,
        help="Output JSONL batch request file.",
    )

    args = parser.parse_args()

    records = load_violations(args.input)

    count = build_batch_requests(
        records,
        args.output,
    )

    print(
        f"Written {count} SHACL batch requests to "
        f"{Path(args.output).resolve()}"
    )


if __name__ == "__main__":
    main()
