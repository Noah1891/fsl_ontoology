<oops:AffectedElement>http://www.softlang.org/ontologies/tbox#classifies</oops:AffectedElement>
<oops:AffectedElement>http://www.softlang.org/ontologies/tbox#uses</oops:AffectedElement>
<oops:AffectedElement>http://www.softlang.org/ontologies/tbox#resolveAfter</oops:AffectedElement>
<oops:AffectedElement>http://www.softlang.org/ontologies/tbox#conformsTo</oops:AffectedElement>
