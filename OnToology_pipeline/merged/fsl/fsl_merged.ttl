ce:EnvironmentProvisioning a tbox:ConceptualEntity ;
    rdfs:label "Environment provisioning"@en ;
    rdfs:subClassOf ce:SupportActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Provisioning> .

ce:ErrorHandlingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:EvaluationStrategyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:EvolutionAndImprovementActivity a tbox:ConceptualEntity ;
    rdfs:label "Evolution and improvement activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_evolution> .

ce:Experimentation a tbox:ConceptualEntity ;
    rdfs:label "Experimentation"@en ;
    rdfs:subClassOf ce:SupportActivity ;
