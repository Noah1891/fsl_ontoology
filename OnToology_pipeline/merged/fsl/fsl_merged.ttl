ce:Documentation a tbox:ConceptualEntity ;
    rdfs:label "Documentation"@en ;
    rdfs:subClassOf ce:QualityAndGovernanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Documentation> .

ce:EffectConcept a tbox:ConceptualEntity,
