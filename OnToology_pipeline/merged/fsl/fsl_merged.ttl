@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ae: <http://www.softlang.org/ontologies/ae#> .
@prefix ce: <http://www.softlang.org/ontologies/ce#> .
@prefix fe: <http://www.softlang.org/ontologies/fe#> .
@prefix ie: <http://www.softlang.org/ontologies/ie#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix pe: <http://www.softlang.org/ontologies/pe#> .
@prefix le: <http://www.softlang.org/ontologies/le#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .
@prefix te: <http://www.softlang.org/ontologies/te#> .

<http://www.softlang.org/ontologies/fsl> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Ontology on the foundations of software languages"@en .

ae:APIDescriptionArtifact a tbox:ArtifactEntity ;
    rdfs:label "API description artifact"@en ;
    tbox:elementOf le:InterfaceDescriptionLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:BuildScriptArtifact a tbox:ArtifactEntity ;
    rdfs:label "Build script artifact"@en ;
    tbox:elementOf le:BuildScriptingLanguage ;
    rdfs:comment "artifact kind for build scripts and build automation specifications"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> .

ae:ConfigurationArtifact a tbox:ArtifactEntity ;
    rdfs:label "Configuration artifact"@en ;
    tbox:elementOf le:ConfigurationLanguage ;
    rdfs:comment "artifact kind for configuration files and related configuration-level assets"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_file> .

ae:GrammarArtifact a tbox:ArtifactEntity ;
    rdfs:label "Grammar artifact"@en ;
    tbox:elementOf le:GrammarMetalanguage ;
    tbox:conformsTo ae:GrammarOfGrammarsArtifact ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:GrammarOfGrammarsArtifact a tbox:ArtifactEntity ;
    rdfs:label "Grammar of grammars artifact"@en ;
    tbox:elementOf le:GrammarMetalanguage ;
    tbox:defines le:GrammarMetalanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:GraphQueryArtifact a tbox:ArtifactEntity ;
    rdfs:label "Graph query artifact"@en ;
    tbox:elementOf le:GraphQueryLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:JSONDocumentArtifact a tbox:ArtifactEntity ;
    rdfs:label "JSON document artifact"@en ;
    tbox:conformsTo ae:JSONSchemaArtifact ;
    tbox:elementOf le:JSON ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:JSONSchemaArtifact a tbox:ArtifactEntity ;
    rdfs:label "JSON schema artifact"@en ;
    tbox:classifies ae:JSONDocumentArtifact ;
    tbox:elementOf le:JSONSchemaLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:LogicProgramArtifact a tbox:ArtifactEntity ;
    rdfs:label "Logic-program artifact"@en ;
    tbox:elementOf pe:ProgrammingLanguage ;
    rdfs:comment "artifact kind typically associated with logic-paradigm programming languages such as Prolog and Datalog"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:MarkupArtifact a tbox:ArtifactEntity ;
    rdfs:label "Markup artifact"@en ;
    tbox:elementOf le:MarkupLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:MetamodelArtifact a tbox:ArtifactEntity ;
    rdfs:label "Metamodel artifact"@en ;
    tbox:elementOf le:MetamodelingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:ModelArtifact a tbox:ArtifactEntity ;
    rdfs:label "Model artifact"@en ;
    tbox:conformsTo ae:MetamodelArtifact ;
    tbox:elementOf le:ModelingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:MegamodelArtifact a tbox:ArtifactEntity ;
    rdfs:label "Megamodel artifact"@en ;
    tbox:elementOf le:MegamodelingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    tbox:hasBibTeX "FavreLaemmelVaranovich2012LinguisticArchitecture" ,
        "FavreNguyen2004MegamodelEvolution" .

ae:OntologyArtifact a tbox:ArtifactEntity ;
    rdfs:label "Ontology artifact"@en ;
    tbox:classifies ae:RDFGraphArtifact ;
    tbox:elementOf le:OntologyLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:ProgramArtifact a tbox:ArtifactEntity ;
    rdfs:label "Program artifact"@en ;
    tbox:elementOf pe:ProgrammingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:ProofArtifact a tbox:ArtifactEntity ;
    rdfs:label "Proof artifact"@en ;
    tbox:elementOf le:ProofLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:SemanticDataArtifact a tbox:ArtifactEntity ;
    rdfs:label "Semantic data artifact"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:PropertyGraphArtifact a tbox:ArtifactEntity ;
    rdfs:label "Property graph artifact"@en ;
    tbox:elementOf le:PropertyGraphDataModelLanguage ;
    rdfs:subClassOf ae:SemanticDataArtifact .

ae:RDFGraphArtifact a tbox:ArtifactEntity ;
    rdfs:label "RDF graph artifact"@en ;
    tbox:conformsTo ae:ShapeArtifact ;
    tbox:elementOf le:RDF ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:RelationalDataArtifact a tbox:ArtifactEntity ;
    rdfs:label "Relational data artifact"@en ;
    tbox:conformsTo ae:RelationalSchemaArtifact ;
    tbox:elementOf le:SQLDML ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:RelationalQueryArtifact a tbox:ArtifactEntity ;
    rdfs:label "Relational query artifact"@en ;
    tbox:elementOf le:SQLQuery ;
    rdfs:subClassOf ae:SemanticDataArtifact .

ae:RelationalSchemaArtifact a tbox:ArtifactEntity ;
    rdfs:label "Relational schema artifact"@en ;
    tbox:classifies ae:RelationalDataArtifact ;
    tbox:elementOf le:SQLDDL ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:RequirementsArtifact a tbox:ArtifactEntity ;
    rdfs:label "Requirements artifact"@en ;
    tbox:elementOf le:RequirementsSpecificationLanguage ;
    rdfs:comment "artifact kind for requirements specifications and similar requirements-level documents or models"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    foaf:page <https://en.wikipedia.org/wiki/Software_requirements_specification> .

ae:RuleArtifact a tbox:ArtifactEntity ;
    rdfs:label "Rule artifact"@en ;
    tbox:elementOf le:RuleLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:ShapeArtifact a tbox:ArtifactEntity ;
    rdfs:label "Shape artifact"@en ;
    tbox:classifies ae:RDFGraphArtifact ;
    tbox:elementOf le:ConstraintLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:XMLDocumentArtifact a tbox:ArtifactEntity ;
    rdfs:label "XML document artifact"@en ;
    tbox:conformsTo ae:XMLSchemaArtifact ;
    tbox:elementOf le:XML ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:XMLSchemaArtifact a tbox:ArtifactEntity ;
    rdfs:label "XML schema artifact"@en ;
    tbox:classifies ae:XMLDocumentArtifact ;
    tbox:elementOf le:XMLSchemaLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact .

ae:XMLDocumentArtifact owl:disjointWith ae:JSONDocumentArtifact .

ae:XMLSchemaArtifact owl:disjointWith ae:JSONSchemaArtifact .

ae:GrammarArtifact owl:disjointWith ae:MetamodelArtifact .

ae:GrammarOfGrammarsArtifact owl:disjointWith ae:MetamodelArtifact .

[ a owl:AllDisjointClasses ;
    owl:members ( ae:SemanticDataArtifact ae:ModelArtifact ae:ProgramArtifact ) ] .

ce:AbstractionConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:AcceptanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Acceptance testing"@en ;
    rdfs:subClassOf ce:ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Acceptance_testing> .

ce:APIDesign a tbox:ConceptualEntity ;
    rdfs:label "API design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf ce:InterfaceDesign ;
    foaf:page <https://en.wikipedia.org/wiki/API> .

ce:Auditing a tbox:ConceptualEntity ;
    rdfs:label "Auditing"@en ;
    rdfs:subClassOf ce:QualityAndGovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Audit> .

ce:BackupAndRecovery a tbox:ConceptualEntity ;
    rdfs:label "Backup and recovery"@en ;
    rdfs:subClassOf ce:OperationsAndMaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Backup>,
        <https://en.wikipedia.org/wiki/Data_recovery> .

ce:BindingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:BugFixing a tbox:ConceptualEntity ;
    rdfs:label "Bug fixing"@en ;
    rdfs:subClassOf ce:OperationsAndMaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_bug> .

ce:BuildScripting a tbox:ConceptualEntity ;
    rdfs:label "Build scripting"@en ;
    tbox:hasOutputArtifact ae:BuildScriptArtifact ;
    tbox:hasSupportingLanguage le:BuildScriptingLanguage ;
    tbox:hasSupportingTool te:BuildTool ;
    rdfs:subClassOf ce:ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> .

ce:CapacityPlanning a tbox:ConceptualEntity ;
    rdfs:label "Capacity planning"@en ;
    rdfs:subClassOf ce:OperationsAndMaintenanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Capacity_management> .

ce:ChangeManagement a tbox:ConceptualEntity ;
    rdfs:label "Change management"@en ;
    rdfs:subClassOf ce:EvolutionAndImprovementActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Change_management> .

ce:CodeGeneration a tbox:ConceptualEntity ;
    rdfs:label "Code generation"@en ;
    tbox:hasInputArtifact ae:GrammarArtifact,
        ae:ModelArtifact ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelTransformationLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ModelTransformationEngine ;
    tbox:uses fe:MetaprogrammingApproach ;
    rdfs:subClassOf ce:Implementation ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> .

ce:CodeGenerationConcept a tbox:ConceptualEntity ;
    rdfs:label "Code generation concept"@en ;
    rdfs:subClassOf ce:MetaprogrammingConcept ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> .

ce:CodeInspection a tbox:ConceptualEntity ;
    rdfs:label "Code inspection"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf ce:VerificationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_inspection> .

ce:CodeReview a tbox:ConceptualEntity ;
    rdfs:label "Code review"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf ce:ImplementationActivity,
        ce:VerificationAndValidationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Code_review> .

ce:Coding a tbox:ConceptualEntity ;
    rdfs:label "Coding"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    rdfs:subClassOf ce:Implementation ;
    foaf:page <https://en.wikipedia.org/wiki/Computer_programming> .

ce:ComplianceManagement a tbox:ConceptualEntity ;
    rdfs:label "Compliance management"@en ;
    rdfs:subClassOf ce:QualityAndGovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Regulatory_compliance> .

ce:ConcurrencyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:ConfigurationManagementPlanning a tbox:ConceptualEntity ;
    rdfs:label "Configuration management planning"@en ;
    rdfs:subClassOf ce:PlanningAndManagementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_management> .

ce:ConstraintConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Constraint concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept .

ce:ContinuousDelivery a tbox:ConceptualEntity ;
    rdfs:label "Continuous delivery"@en ;
    rdfs:subClassOf ce:ReleaseAndDeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_delivery> .

ce:ContinuousDeployment a tbox:ConceptualEntity ;
    rdfs:label "Continuous deployment"@en ;
    rdfs:subClassOf ce:ReleaseAndDeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_deployment> .

ce:ContinuousIntegration a tbox:ConceptualEntity ;
    rdfs:label "Continuous integration"@en ;
    rdfs:subClassOf ce:ReleaseAndDeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_integration> .

ce:ControlConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:DataConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf ce:PrimitiveConcept .

ce:DataModelDesign a tbox:ConceptualEntity ;
    rdfs:label "Data model design"@en ;
    tbox:hasSupportingLanguage le:DataDefinitionLanguage,
        le:OntologyLanguage,
        le:SemanticDataModelLanguage ;
    tbox:uses fe:DataManagementApproach ;
    rdfs:subClassOf ce:DesignActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Data_model> .

ce:DependencyManagement a tbox:ConceptualEntity ;
    rdfs:label "Dependency management"@en ;
    rdfs:subClassOf ce:ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Package_manager> .

ce:Deployment a tbox:ConceptualEntity ;
    rdfs:label "Deployment"@en ;
    rdfs:subClassOf ce:ReleaseAndDeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_deployment> .

ce:DesignActivity a tbox:ConceptualEntity ;
    rdfs:label "Design activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_design> .

ce:DesignValidation a tbox:ConceptualEntity ;
