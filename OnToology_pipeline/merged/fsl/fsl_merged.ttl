        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "SWRL"@en ;
    tbox:hasArea ce:KR,
        ce:SLE ;
    tbox:hasSpace ce:Ontoware,
        ce:Ruleware ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Semantic_Web_Rule_Language> .

le:UMLStateMachine a le:ModelingLanguage,
        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "UML state machine"@en ;
    tbox:hasArea ce:FM,
        ce:MDE,
        ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:Modelware ;
    rdfs:comment "behavioral state machine notation in UML"@en ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/UML_state_machine> .

le:XML a tbox:LanguageEntity,
        tbox:SoftwareLanguage,
        owl:NamedIndividual ;
    rdfs:label "XML"@en ;
    tbox:hasArea ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:XMLware ;
    rdfs:comment "markup language for structured documents and data interchange"@en ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/XML> .

le:XMLSchema a le:XMLSchemaLanguage,
        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "XML Schema"@en ;
    tbox:hasArea ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:XMLware ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/XML_Schema_(W3C)> .

le:XPath a le:XMLQueryLanguage,
        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "XPath"@en ;
    tbox:hasArea ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:XMLware ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/XPath> .

le:XQuery a le:XMLQueryLanguage,
        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "XQuery"@en ;
    tbox:hasArea ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:XMLware ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/XQuery> .

le:XSLT a le:DocumentTransformationLanguage,
        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "XSLT"@en ;
    tbox:hasArea ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:XMLware ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/XSLT> .

le:YAML a le:ConfigurationLanguage,
        tbox:LanguageEntity,
        owl:NamedIndividual ;
    rdfs:label "YAML"@en ;
    tbox:hasArea ce:SE,
        ce:SLE ;
    tbox:hasSpace ce:Markupware ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/YAML> .

[ a owl:AllDisjointClasses ;
    owl:members ( le:BuildScriptingLanguage le:ConfigurationLanguage le:InterfaceDescriptionLanguage le:MappingLanguage le:MarkupLanguage le:Metalanguage le:ModelingLanguage le:OntologyLanguage le:ProofLanguage le:RequirementsSpecificationLanguage le:RuleLanguage le:SchemaLanguage le:SemanticDataModelLanguage pe:ProgrammingLanguage ) ] .

le:BuildScriptingLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:ConfigurationLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:InterfaceDescriptionLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:MappingLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:MarkupLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:Metalanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:ModelingLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:OntologyLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:ProofLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:RequirementsSpecificationLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:RuleLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:SchemaLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
le:SemanticDataModelLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .
pe:ProgrammingLanguage owl:disjointWith [ a owl:Class ; owl:unionOf ( le:ConstraintLanguage le:QueryLanguage le:TransformationLanguage le:DataManipulationLanguage le:DataDefinitionLanguage ) ] .

tbox:ArtifactEntity rdfs:subClassOf tbox:Entity ;
    rdfs:label "Artifact entity"@en ;
    tbox:metamodelingPolicy "All non-immediate subclasses must also be of this type."@en ;
    rdfs:comment "Ontological entity used to represent software artifacts, artifact families, and artifact-related instances"@en .

tbox:Assertion rdfs:subClassOf tbox:ConceptualEntity ;
    rdfs:label "Assertion"@en ;
    rdfs:comment "Reified assertion entity used for qualified statements in language-related modules"@en ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Reification_(knowledge_representation)> .

tbox:ConceptualEntity rdfs:subClassOf tbox:Entity ;
    rdfs:label "Conceptual entity"@en ;
    tbox:metamodelingPolicy "All non-immediate subclasses must also be of this type."@en ;
    rdfs:comment "Contextual concepts for other entity types (foundations, languages, tools, and artifacts)"@en .

tbox:EngineeringActivity a tbox:ConceptualEntity ;
    rdfs:label "Engineering activity"@en ;
    rdfs:comment "Root class for software engineering activity types."@en ;
    rdfs:subClassOf tbox:ConceptualEntity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_development_process> .

tbox:SubjectArea a tbox:ConceptualEntity ;
    rdfs:label "Subject area"@en ;
    rdfs:comment "research or application area relevant to the foundations of software languages and related disciplines"@en ;
    rdfs:subClassOf tbox:ConceptualEntity .

tbox:TechnologicalSpace a tbox:ConceptualEntity ;
    rdfs:label "Technological space"@en ;
    rdfs:comment "Technological spaces are families of related software-language technologies that share characteristic artifact kinds, metalanguages, tools, conformance relations, skills, and communities of practice. A technological space is not just a single language or formalism, but a working context in which artifacts are defined, manipulated, queried, transformed, validated, exchanged, and executed according to characteristic principles. This class represents such ecosystems."@en ;
    tbox:hasBibTeX "KurtevBezivinAksit2002TechnologicalSpaces" ;
    rdfs:subClassOf tbox:ConceptualEntity .

tbox:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "Top-level category for entities represented in this ontology. Entities should be linked to at least one descriptive document via foaf:isPrimaryTopicOf or foaf:page."@en ;
    foaf:page <https://en.wikipedia.org/wiki/Knowledge_representation_and_reasoning> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty foaf:isPrimaryTopicOf ;
                        owl:someValuesFrom foaf:Document ] [ a owl:Restriction ;
                        owl:onProperty foaf:page ;
                        owl:someValuesFrom foaf:Document ] ) ] .

tbox:FormalEntity rdfs:subClassOf tbox:Entity ;
    rdfs:label "Formal entity"@en ;
    rdfs:comment "Ontological entity used to represent formal formalisms, theories, models of computation, and methodological approaches"@en ;
    tbox:metamodelingPolicy "All non-immediate subclasses must also be of this type."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass tbox:SubjectArea ;
            owl:onProperty tbox:hasArea ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass tbox:TechnologicalSpace ;
            owl:onProperty tbox:hasSpace ] .

tbox:MethodologicalApproach a tbox:FormalEntity ;
    rdfs:label "Methodological approach"@en ;
    rdfs:comment "class of formal entities that represent methodological orientations, techniques, or styles of treatment used in the study or engineering of software languages and related formalisms"@en ;
    rdfs:subClassOf tbox:FormalEntity .

tbox:PropertyEntity rdfs:subClassOf tbox:Entity ;
    rdfs:label "Property entity"@en ;
    rdfs:comment "Ontological entity used to represent property declarations that participate in relations like other modeled entities"@en .

tbox:IssueEntity rdfs:subClassOf tbox:Entity ;
    rdfs:label "Issue entity"@en ;
    rdfs:comment "Entity for representing review issues, critiques, and proposed resolutions concerning resources, predicates, or fully specified assertions in the ontology"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> .

tbox:LanguageEntity rdfs:subClassOf tbox:Entity ;
    rdfs:label "Language entity"@en ;
    tbox:metamodelingPolicy "All non-immediate subclasses must also be of this type."@en ;
    rdfs:comment "Ontological entity used to represent software languages, language families, and language-related instances"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass tbox:TechnologicalSpace ;
            owl:onProperty tbox:hasSpace ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass tbox:SubjectArea ;
            owl:onProperty tbox:hasArea ] .

tbox:SoftwareArtifact a tbox:ArtifactEntity ;
    rdfs:label "Software artifact"@en ;
    rdfs:comment "Software artifact kind used to classify the characteristic artifacts of a technological space"@en ;
    rdfs:subClassOf tbox:ArtifactEntity .

tbox:SoftwareLanguage a tbox:LanguageEntity ;
    rdfs:label "Software language"@en ;
    rdfs:comment "Concrete software languages (e.g., XML, SQL, OWL) are represented as individuals of this class. Language families are represented as subclasses. Artifact kinds capture the kinds of artifacts written in such languages."@en ;
    rdfs:subClassOf tbox:LanguageEntity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_language> .

tbox:SoftwareTool a tbox:ToolEntity ;
    rdfs:label "Software tool"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Programming_tool> ;
    rdfs:subClassOf tbox:ToolEntity .

tbox:ToolEntity rdfs:label "Tool entity"@en ;
    tbox:metamodelingPolicy "All non-immediate subclasses must also be of this type."@en ;
    rdfs:comment "Ontological entity used to represent software tools, tool families, and tool-related instances"@en ;
    rdfs:subClassOf tbox:Entity .

tbox:classifies a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "classifies"@en ;
    rdfs:comment "Relates an artifact to another artifact in the generalized sense of metamodels classifying models"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Metamodeling> ;
    rdfs:domain tbox:ArtifactEntity ;
    rdfs:range tbox:ArtifactEntity ;
    owl:inverseOf tbox:conformsTo .

tbox:commentingPolicy a owl:AnnotationProperty,
        tbox:PropertyEntity ;
    rdfs:label "Commenting policy"@en ;
    rdfs:comment "Documents the ontology-wide expectation regarding commenting"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Guideline> .

tbox:conformsTo a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "conforms to"@en ;
    rdfs:comment "Relates an artifact to another artifact in the generalized sense of models conforming to metamodels"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Metamodeling> ;
    tbox:hasBibTeX "AtkinsonKuehne2003MetamodelingFoundation",
        "AtkinsonGerbig2016OntologicalClassification",
        "DegueuleEtAl2017SafeModelPolymorphism",
        "RossiniDeLaraGuerraEtAl2014DeepMetamodelling",
        "Favre2005MetaPyramids" ;
    rdfs:domain tbox:ArtifactEntity ;
    rdfs:range tbox:ArtifactEntity ;
    owl:inverseOf tbox:classifies .

tbox:critique a owl:DatatypeProperty,
        tbox:PropertyEntity ;
    rdfs:label "critique"@en ;
    rdfs:comment "Describes the problem, concern, or critique expressed by an issue"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity ;
    rdfs:range rdf:langString .

tbox:defines a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "defines"@en ;
    rdfs:comment "Relates an artifact to a language in the sense of a definition (specification)"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Programming_language_specification> ;
    rdfs:domain tbox:ArtifactEntity ;
    rdfs:range tbox:LanguageEntity ;
    owl:inverseOf tbox:isDefinedBy .

tbox:elementOf a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "element of"@en ;
    rdfs:comment "Relates an artifact to a language in the set-theoretic sense"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Membership_function_(mathematics)> ;
    tbox:hasBibTeX "Favre2005MetaPyramids" ;
    rdfs:domain tbox:ArtifactEntity ;
    rdfs:range tbox:LanguageEntity ;
    owl:inverseOf tbox:hasElement .

tbox:extends a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "extends"@en ;
    rdfs:comment "Relates a software language to another software language that it extends or generalizes"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:SoftwareLanguage ;
    rdfs:range tbox:SoftwareLanguage ;
    owl:inverseOf tbox:isExtendedBy .

tbox:formattingPolicy a owl:AnnotationProperty,
        tbox:PropertyEntity ;
    rdfs:label "Formatting policy"@en ;
    rdfs:comment "Documents the ontology-wide expectation regarding formatting"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Guideline> .

tbox:linkingPolicy a owl:AnnotationProperty,
        tbox:PropertyEntity ;
    rdfs:label "Linking policy"@en ;
    rdfs:comment "Documents ontology-wide expectations for linking classes and individuals to descriptive web pages"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Guideline> .

tbox:hasAffectedArtifact a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has affected artifact"@en ;
    rdfs:comment "Relates an activity or a tool to an artifact kind that it typically affects (thereby complementing in- and output)"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Artifact_(software_development)> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( tbox:EngineeringActivity tbox:ToolEntity ) ] ;
    rdfs:range tbox:ArtifactEntity .

tbox:hasArea a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has area"@en ;
    rdfs:comment "Relates an entity to an important subject area of interest"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Academic_discipline> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:SubjectArea ;
    owl:inverseOf tbox:isAreaOf .

tbox:hasArtifact a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has artifact"@en ;
    rdfs:comment "Relates a technological space to a kind of artifact that it is concerned with"@en ;    
    foaf:page <https://en.wikipedia.org/wiki/Artifact_(software_development)> ;
    rdfs:domain tbox:TechnologicalSpace ;
    rdfs:range tbox:ArtifactEntity ;
    owl:inverseOf tbox:isArtifactOf .

tbox:hasBibTeX a owl:DatatypeProperty,
        tbox:PropertyEntity ;
    rdfs:label "has BibTeX"@en ;
    rdfs:comment "Relates an entity to the BibTeX key of a bibliographic entry that documents, discusses, or supports it"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Annotated_bibliography> ;
    rdfs:domain tbox:Entity ;
    rdfs:range xsd:string .

tbox:hasElement a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has element"@en ;
    rdfs:comment "Relates a language to an artifact in the set-theoretic sense"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Membership_function_(mathematics)> ;
    rdfs:domain tbox:LanguageEntity ;
    rdfs:range tbox:ArtifactEntity ;
    owl:inverseOf tbox:elementOf .

tbox:hasInputArtifact a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has input artifact"@en ;
    rdfs:comment "Relates an activity or a tool to an artifact kind that it typically requires or consumes as input"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Artifact_(software_development)> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( tbox:EngineeringActivity tbox:ToolEntity ) ] ;
    rdfs:range tbox:ArtifactEntity .

tbox:hasOutputArtifact a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has output artifact"@en ;
    rdfs:comment "Relates an activity or a tool to an artifact kind that it typically produces as output"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Artifact_(software_development)> ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( tbox:EngineeringActivity tbox:ToolEntity ) ] ;
    rdfs:range tbox:ArtifactEntity .

tbox:hasPart a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "Relates an ontology entity to another ontology entity that is a structural part or constituent of it"@en ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Mereology> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:Entity ;
    rdfs:subPropertyOf tbox:uses ;
    owl:inverseOf tbox:isPartOf .

tbox:hasSpace a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has space"@en ;
    rdfs:comment "Relates an entity to a technological space to which it characteristically belongs"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:TechnologicalSpace ;
    owl:inverseOf tbox:isSpaceOf .

tbox:hasSupportingLanguage a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has supporting language"@en ;
    rdfs:comment "Relates a software engineering activity to a language kind that is characteristically used to perform or express the activity"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:EngineeringActivity ;
    rdfs:range tbox:LanguageEntity .

tbox:hasSupportingTool a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has supporting tool"@en ;
    rdfs:comment "Relates a software engineering activity to a tool kind that characteristically supports carrying out the activity"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:EngineeringActivity ;
    rdfs:range tbox:ToolEntity .

tbox:hasTool a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "has tool"@en ;
    rdfs:comment "Relates a technological space to a kind of tool that it is concerned with"@en ;    
    foaf:page <https://en.wikipedia.org/wiki/Programming_tool> ;
    rdfs:domain tbox:TechnologicalSpace ;
    rdfs:range tbox:ToolEntity ;
    owl:inverseOf tbox:isToolOf .

tbox:isAreaOf a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is area of"@en ;
    rdfs:comment "Relates a subject area to an entity for which it is an important area of interest"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Academic_discipline> ;
    rdfs:domain tbox:SubjectArea ;
    rdfs:range tbox:Entity ;
    owl:inverseOf tbox:hasArea .

tbox:isArtifactOf a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is artifact of"@en ;
    rdfs:comment "Relates an artifact to its technological space"@en ;    
    foaf:page <https://en.wikipedia.org/wiki/Artifact_(software_development)> ;
    rdfs:domain tbox:ArtifactEntity ;
    rdfs:range tbox:TechnologicalSpace ;
    owl:inverseOf tbox:hasArtifact .

tbox:isDefinedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is defined by"@en ;
    rdfs:comment "Relates a language to an artifact in the sense of a definition (specification)"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Programming_language_specification> ;
    rdfs:domain tbox:LanguageEntity ;
    rdfs:range tbox:ArtifactEntity ;
    owl:inverseOf tbox:defines .

tbox:isExtendedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is extended by"@en ;
    rdfs:comment "Relates a software language to another software language that extends or generalizes it"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:SoftwareLanguage ;
    rdfs:range tbox:SoftwareLanguage ;
    owl:inverseOf tbox:extends .

tbox:isPartOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Relates an ontology entity to another ontology entity of which it is a structural part or constituent"@en ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Mereology> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:Entity ;
    rdfs:subPropertyOf tbox:isUsedBy ;
    owl:inverseOf tbox:hasPart .

tbox:isProcessedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is processed by"@en ;
    rdfs:comment "Relates an artifact entity to a tool entity that characteristically processes it"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:ArtifactEntity ;
    rdfs:range tbox:ToolEntity ;
    owl:inverseOf tbox:processes .

tbox:isServedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is served by"@en ;
    rdfs:comment "Relates a methodological approach to an entity that serves, realizes, supports, or instantiates it in an important way"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:MethodologicalApproach ;
    rdfs:range tbox:Entity ;
    owl:inverseOf tbox:serves .

tbox:isSpaceOf a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is space of"@en ;
    rdfs:comment "Relates a technological space to an entity that characteristically belongs to it"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:TechnologicalSpace ;
    rdfs:range tbox:Entity ;
    owl:inverseOf tbox:hasSpace .

tbox:isSpecifiedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is specified by"@en ;
    rdfs:comment "Relates an entity to a methodological approach used to formally specify or define its behavior or meaning"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:FormalEntity ;
    rdfs:range tbox:MethodologicalApproach ;
    owl:inverseOf tbox:specifies .

tbox:isTargetedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is targeted by"@en ;
    rdfs:comment "Relates a language entity to a tool entity that targets it"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:LanguageEntity ;
    rdfs:range tbox:ToolEntity ;
    owl:inverseOf tbox:targets .

tbox:isToolOf a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is tool of"@en ;
    rdfs:comment "Relates a tool to its technological space"@en ;    
    foaf:page <https://en.wikipedia.org/wiki/Programming_tool> ;
    rdfs:domain tbox:ToolEntity ;
    rdfs:range tbox:TechnologicalSpace ;
    owl:inverseOf tbox:hasTool .

tbox:isUsedBy a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "is used by"@en ;
    rdfs:comment "Relates an ontology entity to another ontology entity that uses it conceptually, methodologically, or technically"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:Entity ;
    owl:inverseOf tbox:uses .

tbox:metamodelingPolicy a owl:AnnotationProperty,
        tbox:PropertyEntity ;
    rdfs:label "Metamodeling policy"@en ;
    rdfs:comment "Documents ontology-wide expectations for explicit punning-based typing of classes and individuals"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Guideline> .

tbox:processes a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "processes"@en ;
    rdfs:comment "Relates a tool entity to an artifact entity that it characteristically processes"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:ToolEntity ;
    rdfs:range tbox:ArtifactEntity ;
    owl:inverseOf tbox:isProcessedBy .

tbox:serves a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "serves"@en ;
    rdfs:comment "Relates an entity to a methodological approach that it serves, realizes, supports, or instantiates in an important way"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:MethodologicalApproach ;
    owl:inverseOf tbox:isServedBy .

tbox:specifies a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "specifies"@en ;
    rdfs:comment "Relates a methodological approach to an entity whose behavior or meaning it is used to formally specify or define"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:MethodologicalApproach ;
    rdfs:range tbox:FormalEntity ;
    owl:inverseOf tbox:isSpecifiedBy .

tbox:suggestion a owl:DatatypeProperty,
        tbox:PropertyEntity ;
    rdfs:label "suggestion"@en ;
    rdfs:comment "Records a suggested resolution or improvement for an issue"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity ;
    rdfs:range rdf:langString .

tbox:targets a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "targets"@en ;
    rdfs:comment "Relates a tool entity to a language entity that it targets"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:ToolEntity ;
    rdfs:range tbox:LanguageEntity ;
    owl:inverseOf tbox:isTargetedBy .

tbox:uses a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "uses"@en ;
    rdfs:comment "Relates an ontology entity to another ontology entity that it uses conceptually, methodologically, or technically"@en ;
    foaf:page <https://en.wikipedia.org/wiki/N/A> ;
    rdfs:domain tbox:Entity ;
    rdfs:range tbox:Entity ;
    owl:inverseOf tbox:isUsedBy .

tbox:object a rdf:Property ;
    rdfs:label "object"@en ;
    rdfs:comment "Identifies the object constituent of an issue when the issue concerns a particular assertion; this property designates object role rather than the overall issue target"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity ;
    rdfs:subPropertyOf rdf:object .

tbox:predicate a rdf:Property ;
    rdfs:label "predicate"@en ;
    rdfs:comment "Identifies the predicate constituent of an issue when the issue concerns a particular assertion; this property designates predicate role rather than the overall issue target"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity ;
    rdfs:subPropertyOf rdf:predicate .

tbox:subject a rdf:Property ;
    rdfs:label "subject"@en ;
    rdfs:comment "Identifies the subject constituent of an issue when the issue concerns a particular assertion; this property designates subject role rather than the overall issue target"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity ;
    rdfs:subPropertyOf rdf:subject .

tbox:target a rdf:Property ;
    rdfs:label "target"@en ;
    rdfs:comment "Identifies the primary resource that an issue is about, such as a reviewed resource or an ontology/module addressed as a whole; assertion-level issues are instead designated through subject, predicate, and object"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity .

tbox:resolveAfter a owl:ObjectProperty,
        tbox:PropertyEntity ;
    rdfs:label "resolve after"@en ;
    rdfs:comment "States that an issue needs to be resolved after another issue"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Issue_tracking_system> ;
    rdfs:domain tbox:IssueEntity ;
    rdfs:range tbox:IssueEntity.

# Language-concept schema moved from ce.

tbox:LanguageConcept a tbox:ConceptualEntity ;
    rdfs:label "Language concept"@en ;
    rdfs:comment "concept associated with a language framework such as programming-language concepts"@en ;
    rdfs:subClassOf tbox:ConceptualEntity ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:CompositeConcept a tbox:ConceptualEntity ;
    rdfs:label "Composite concept"@en ;
    rdfs:comment "a language concept as a composite of other language concepts"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:LanguageSupportKind a tbox:ConceptualEntity ;
    rdfs:label "Language support kind"@en ;
    rdfs:comment "kind of support that a language provides for a language concept"@en ;
    rdfs:subClassOf tbox:ConceptualEntity ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:LanguageSupportAssertion a tbox:ConceptualEntity ;
    rdfs:label "Language support assertion"@en ;
    rdfs:comment "reified assertion that a language supports a language concept, optionally qualified"@en ;
    rdfs:subClassOf tbox:Assertion ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:LanguageConceptApplicability a tbox:ConceptualEntity ;
    rdfs:label "Language concept applicability"@en ;
    rdfs:comment "qualifier for how directly a language concept applies to a language"@en ;
    rdfs:subClassOf tbox:ConceptualEntity ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:ImplementationMechanismConcept a tbox:ConceptualEntity ;
    rdfs:label "Implementation mechanism concept"@en ;
    rdfs:comment "a more realization/implementation-oriented category of language concepts"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:supports a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Supports"@en ;
    rdfs:domain tbox:LanguageEntity ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:comment "Relates a language to a concept that it supports"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:nativelySupports a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Natively supports"@en ;
    rdfs:domain tbox:LanguageEntity ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:subPropertyOf tbox:supports ;
    rdfs:comment "Relates a language to a concept that it supports natively"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:standardlySupports a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Standardly supports"@en ;
    rdfs:domain tbox:LanguageEntity ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:subPropertyOf tbox:supports ;
    rdfs:comment "Relates a language to a concept that it supports standardly"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:assertedForConcept a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Asserted for concept"@en ;
    rdfs:domain tbox:LanguageSupportAssertion ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:comment "Relates a reified assertion about language concepts with the concept"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:assertedForLanguage a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Asserted for language"@en ;
    rdfs:domain tbox:LanguageSupportAssertion ;
    rdfs:range tbox:LanguageEntity ;
    rdfs:comment "Relates a reified assertion about language concepts with the language"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasDominantForm a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has dominant form"@en ;
    rdfs:domain tbox:LanguageSupportAssertion ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:comment "Relates a language concept to a dominated form"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasPrimaryMechanism a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has primary mechanism"@en ;
    rdfs:domain tbox:LanguageSupportAssertion ;
    rdfs:range tbox:ImplementationMechanismConcept ;
    rdfs:comment "Relates a reified assertion about language concepts with the primary mechanism for realization"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasApplicability a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has applicability"@en ;
    rdfs:domain tbox:LanguageSupportAssertion ;
    rdfs:range tbox:LanguageConceptApplicability ;
    rdfs:comment "Relates a reified assertion about language concepts with the applicability"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasComponent a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has component"@en ;
    rdfs:domain tbox:CompositeConcept ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:comment "Relates a composite language concept to a component"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasPrimaryComponent a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has primary component"@en ;
    rdfs:domain tbox:CompositeConcept ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:subPropertyOf tbox:hasComponent ;
    rdfs:comment "Relates a composite language concept to a (primary) component"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasSecondaryComponent a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has secondary component"@en ;
    rdfs:domain tbox:CompositeConcept ;
    rdfs:range tbox:LanguageConcept ;
    rdfs:subPropertyOf tbox:hasComponent ;
    rdfs:comment "Relates a composite language concept to a (secondary) component"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

tbox:hasSupportKind a owl:ObjectProperty ,
        tbox:PropertyEntity ;
    rdfs:label "Has support kind"@en ;
    rdfs:domain tbox:LanguageSupportAssertion ;
    rdfs:range tbox:LanguageSupportKind ;
    rdfs:comment "Relates a reified assertion about language concepts with the type of support"@en ;
    foaf:page <https://en.wikipedia.org/wiki/Category:Programming_language_concepts> .

te:APIWorkbench a tbox:ToolEntity ;
