@prefix : <http://www.softlang.org/ontologies/ae#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix le: <http://www.softlang.org/ontologies/le#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <http://www.softlang.org/ontologies/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .

<http://www.softlang.org/ontologies/ae> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Sub-ontology / ABox for software artifacts"@en ;
    owl:imports <http://www.softlang.org/ontologies/tbox> .

:APIDescriptionArtifact a tbox:ArtifactEntity ;
    rdfs:label "API description artifact"@en ;
    tbox:elementOf le:InterfaceDescriptionLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "A software artifact that describes an application programming interface, including its operations, data structures, and interaction contract."@en .

:BuildScriptArtifact a tbox:ArtifactEntity ;
    rdfs:label "Build script artifact"@en ;
    tbox:elementOf le:BuildScriptingLanguage ;
    rdfs:comment "artifact kind for build scripts and build automation specifications"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> .

:ConfigurationArtifact a tbox:ArtifactEntity ;
    rdfs:label "Configuration artifact"@en ;
    tbox:elementOf le:ConfigurationLanguage ;
    rdfs:comment "artifact kind for configuration files and related configuration-level assets"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_file> .

:GrammarArtifact a tbox:ArtifactEntity ;
    rdfs:label "Grammar artifact"@en ;
    tbox:elementOf le:GrammarMetalanguage ;
    tbox:conformsTo :GrammarOfGrammarsArtifact ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that specifies the syntax of a language using a grammar formalism."@en .

:GrammarOfGrammarsArtifact a tbox:ArtifactEntity ;
    rdfs:label "Grammar of grammars artifact"@en ;
    tbox:elementOf le:GrammarMetalanguage ;
    tbox:defines le:GrammarMetalanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "A software artifact that specifies a grammar metalanguage by defining the language used to describe grammars."@en .

:GraphQueryArtifact a tbox:ArtifactEntity ;
    rdfs:label "Graph query artifact"@en ;
    tbox:elementOf le:GraphQueryLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that expresses a query over graph-structured data in a graph query language."@en .

:JSONDocumentArtifact a tbox:ArtifactEntity ;
    rdfs:label "JSON document artifact"@en ;
    tbox:conformsTo :JSONSchemaArtifact ;
    tbox:elementOf le:JSON ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact representing a document encoded in JSON that conforms to a JSON schema artifact."@en .

:JSONSchemaArtifact a tbox:ArtifactEntity ;
    rdfs:label "JSON schema artifact"@en ;
    tbox:classifies :JSONDocumentArtifact ;
    tbox:elementOf le:JSONSchemaLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact written in JSON Schema that specifies the structure and validation constraints for JSON documents."@en .

:LogicProgramArtifact a tbox:ArtifactEntity ;
    rdfs:label "Logic-program artifact"@en ;
    tbox:elementOf pe:ProgrammingLanguage ;
    rdfs:comment "artifact kind typically associated with logic-paradigm programming languages such as Prolog and Datalog"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact .

:MarkupArtifact a tbox:ArtifactEntity ;
    rdfs:label "Markup artifact"@en ;
    tbox:elementOf le:MarkupLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that is written in or represented using a markup language."@en .

:MetamodelArtifact a tbox:ArtifactEntity ;
    rdfs:label "Metamodel artifact"@en ;
    tbox:elementOf le:MetamodelingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact expressed in a metamodeling language that specifies the concepts, relationships, and constraints to which models conform."@en .

:ModelArtifact a tbox:ArtifactEntity ;
    rdfs:label "Model artifact"@en ;
    tbox:conformsTo :MetamodelArtifact ;
    tbox:elementOf le:ModelingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that represents a model, is expressed in a modeling language, and conforms to a metamodel."@en .

:MegamodelArtifact a tbox:ArtifactEntity ;
    rdfs:label "Megamodel artifact"@en ;
    tbox:elementOf le:MegamodelingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    tbox:hasBibTeX "FavreLaemmelVaranovich2012LinguisticArchitecture" ,
        "FavreNguyen2004MegamodelEvolution" ;
    rdfs:comment "A software artifact that represents a megamodel, describing and relating languages, models, metamodels, transformations, and other artifacts in a technological space."@en .

:OntologyArtifact a tbox:ArtifactEntity ;
    rdfs:label "Ontology artifact"@en ;
    tbox:classifies :RDFGraphArtifact ;
    tbox:elementOf le:OntologyLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that encodes an ontology, specifying a conceptualization through formally defined entities, relations, and constraints."@en .

:ProgramArtifact a tbox:ArtifactEntity ;
    rdfs:label "Program artifact"@en ;
    tbox:elementOf pe:ProgrammingLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact consisting of program code expressed in a programming language, such as source code or an executable program."@en .

:ProofArtifact a tbox:ArtifactEntity ;
    rdfs:label "Proof artifact"@en ;
    tbox:elementOf le:ProofLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that represents a formal proof, typically written in a proof language and created, checked, or processed by a proof assistant."@en .

:SemanticDataArtifact a tbox:ArtifactEntity ;
    rdfs:label "Semantic data artifact"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "A software artifact that represents semantic data, such as data structured according to a semantic data model or knowledge representation formalism."@en .

:PropertyGraphArtifact a tbox:ArtifactEntity ;
    rdfs:label "Property graph artifact"@en ;
    tbox:elementOf le:PropertyGraphDataModelLanguage ;
    rdfs:subClassOf :SemanticDataArtifact ;
    rdfs:comment "Software artifact that represents graph-structured data according to a property graph data model."@en .

:RDFGraphArtifact a tbox:ArtifactEntity ;
    rdfs:label "RDF graph artifact"@en ;
    tbox:conformsTo :ShapeArtifact ;
    tbox:elementOf le:RDF ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact consisting of an RDF graph, i.e., a set of RDF triples, which may conform to a shape artifact."@en .

:RelationalDataArtifact a tbox:ArtifactEntity ;
    rdfs:label "Relational data artifact"@en ;
    tbox:conformsTo :RelationalSchemaArtifact ;
    tbox:elementOf le:SQLDML ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact representing data organized as relations (tables) that conforms to a relational schema and is manipulated using SQL Data Manipulation Language (SQL DML)."@en .

:RelationalQueryArtifact a tbox:ArtifactEntity ;
    rdfs:label "Relational query artifact"@en ;
    tbox:elementOf le:SQLQuery ;
    rdfs:subClassOf :SemanticDataArtifact ;
    rdfs:comment "Software artifact representing a query expressed in a relational query language, such as SQL."@en .

:RelationalSchemaArtifact a tbox:ArtifactEntity ;
    rdfs:label "Relational schema artifact"@en ;
    tbox:classifies :RelationalDataArtifact ;
    tbox:elementOf le:SQLDDL ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that specifies the structure of a relational database, including relations, attributes, and constraints, and to which relational data artifacts conform."@en .

:RequirementsArtifact a tbox:ArtifactEntity ;
    rdfs:label "Requirements artifact"@en ;
    tbox:elementOf le:RequirementsSpecificationLanguage ;
    rdfs:comment "artifact kind for requirements specifications and similar requirements-level documents or models"@en ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    foaf:page <https://en.wikipedia.org/wiki/Software_requirements_specification> .

:RuleArtifact a tbox:ArtifactEntity ;
    rdfs:label "Rule artifact"@en ;
    tbox:elementOf le:RuleLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that encodes rules in a rule language for processing, validation, or symbolic rule-based reasoning."@en .

:ShapeArtifact a tbox:ArtifactEntity ;
    rdfs:label "Shape artifact"@en ;
    tbox:classifies :RDFGraphArtifact ;
    tbox:elementOf le:ConstraintLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact that specifies structural and semantic constraints used to validate or classify RDF graph artifacts."@en .

:XMLDocumentArtifact a tbox:ArtifactEntity ;
    rdfs:label "XML document artifact"@en ;
    tbox:conformsTo :XMLSchemaArtifact ;
    tbox:elementOf le:XML ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact representing an XML document, expressed in XML and conforming to an XML schema artifact."@en .

:XMLSchemaArtifact a tbox:ArtifactEntity ;
    rdfs:label "XML schema artifact"@en ;
    tbox:classifies :XMLDocumentArtifact ;
    tbox:elementOf le:XMLSchemaLanguage ;
    rdfs:subClassOf tbox:SoftwareArtifact ;
    rdfs:comment "Software artifact, expressed in an XML schema language, that defines the permitted structure and constraints of XML documents."@en .

:XMLDocumentArtifact owl:disjointWith :JSONDocumentArtifact .

:XMLSchemaArtifact owl:disjointWith :JSONSchemaArtifact .

:GrammarArtifact owl:disjointWith :MetamodelArtifact .

:GrammarOfGrammarsArtifact owl:disjointWith :MetamodelArtifact .

[ a owl:AllDisjointClasses ;
    owl:members ( :SemanticDataArtifact :ModelArtifact :ProgramArtifact ) ] .
