    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Reengineering> ;
    rdfs:comment "An engineering activity concerned with analyzing, restructuring, and transforming an existing software system to improve its quality, maintainability, or adaptability, typically while preserving its functionality."@en .

:Refactoring a tbox:ConceptualEntity ;
    rdfs:label "Refactoring"@en ;
    tbox:hasAffectedArtifact ae:ProgramArtifact ;
