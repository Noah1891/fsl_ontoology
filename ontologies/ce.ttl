    rdfs:comment "The engineering activity of eliciting, analyzing, documenting, and managing stakeholder requirements for a software system or other artifact."@en .

:RequirementsElicitation a tbox:ConceptualEntity ;
    rdfs:label "Requirements elicitation"@en ;
    rdfs:subClassOf :RequirementsEngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Requirements_elicitation> ;
    rdfs:comment "The activity of identifying, discovering, and gathering stakeholders' needs, expectations, and constraints for a system under development."@en .

:RequirementsEngineeringActivity a tbox:ConceptualEntity ;
    rdfs:label "Requirements engineering activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Requirements_engineering> ;
    rdfs:comment "An engineering activity concerned with eliciting, analyzing, specifying, validating, prioritizing, and managing software requirements."@en .

:RequirementsManagement a tbox:ConceptualEntity ;
    rdfs:label "Requirements management"@en ;
    rdfs:subClassOf :RequirementsEngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Requirements_engineering> ;
    rdfs:comment "An engineering activity concerned with documenting, analyzing, prioritizing, tracking, and controlling changes to software requirements throughout their lifecycle."@en .

:RequirementsPrioritization a tbox:ConceptualEntity ;
