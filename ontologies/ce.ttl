@prefix : <http://www.softlang.org/ontologies/ce#> .
@prefix ae: <http://www.softlang.org/ontologies/ae#> .
@prefix fe: <http://www.softlang.org/ontologies/fe#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix le: <http://www.softlang.org/ontologies/le#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <http://www.softlang.org/ontologies/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .
@prefix te: <http://www.softlang.org/ontologies/te#> .

<http://www.softlang.org/ontologies/ce> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Sub-ontology / ABox for conceptual entities"@en,
        "This module also hosts the reusable language-concept framework used across software-language modules."@en ;
    owl:imports <http://www.softlang.org/ontologies/tbox> .

:AbstractionConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Abstraction concept"@en ;
        rdfs:comment "A primitive language concept that characterizes mechanisms for managing complexity by emphasizing essential features while hiding or omitting implementation details."@en .

:AcceptanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Acceptance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Acceptance_testing> ;
    rdfs:comment "Testing activity performed to determine whether a system satisfies specified acceptance criteria and is ready for acceptance by its intended users or customer."@en .

:APIDesign a tbox:ConceptualEntity ;
    rdfs:label "API design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :InterfaceDesign ;
    foaf:page <https://en.wikipedia.org/wiki/API> ;
    rdfs:comment "The software engineering activity of designing an application programming interface (API), including the definition of its operations, data structures, and interaction contracts."@en .

:Auditing a tbox:ConceptualEntity ;
    rdfs:label "Auditing"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Audit> ;
    rdfs:comment "An engineering activity that systematically examines software processes, artifacts, or practices to assess compliance, quality, effectiveness, and adherence to applicable standards or requirements."@en .

:Backup a tbox:ConceptualEntity ;
    rdfs:label "Backup"@en ;
    rdfs:comment "An operations and maintenance activity that creates a copy of data so it can be restored after loss or corruption."@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Backup> .

:Recovery a tbox:ConceptualEntity ;
    rdfs:label "Recovery"@en ;
    rdfs:comment "An operations and maintenance activity that restores data or systems following loss, corruption, or failure."@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Data_recovery> .

:BindingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Binding concept"@en ;
        rdfs:comment "A primitive language concept concerning the association of names or other identifiers with program entities, values, types, or locations, including the time at which such associations are established."@en .

:BugFixing a tbox:ConceptualEntity ;
    rdfs:label "Bug fixing"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_bug> ;
    rdfs:comment "An operations and maintenance activity that identifies, diagnoses, and corrects defects in software."@en .

:BuildScripting a tbox:ConceptualEntity ;
    rdfs:label "Build scripting"@en ;
    tbox:hasOutputArtifact ae:BuildScriptArtifact ;
    tbox:hasSupportingLanguage le:BuildScriptingLanguage ;
    tbox:hasSupportingTool te:BuildTool ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> ;
    rdfs:comment "An implementation activity that automates the building of software artifacts using build scripts, build scripting languages, and build tools."@en .

:CapacityPlanning a tbox:ConceptualEntity ;
    rdfs:label "Capacity planning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Capacity_management> ;
    rdfs:comment "An operations and maintenance activity that plans and manages computing-resource capacity to meet current and anticipated workload demands."@en .

:ChangeManagement a tbox:ConceptualEntity ;
    rdfs:label "Change management"@en ;
    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Change_management> ;
    rdfs:comment "A software engineering activity concerned with planning, controlling, and implementing changes to software systems, their artifacts, and related processes."@en .

:CodeGeneration a tbox:ConceptualEntity ;
    rdfs:label "Code generation"@en ;
    tbox:hasInputArtifact ae:GrammarArtifact,
        ae:ModelArtifact ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelTransformationLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ModelTransformationEngine ;
    tbox:uses fe:MetaprogrammingApproach ;
    rdfs:subClassOf :Implementation ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "An implementation activity that automatically produces program artifacts from higher-level inputs, such as models or grammar artifacts, using programming or model transformation languages and supporting tools."@en .

:CodeGenerationConcept a tbox:ConceptualEntity ;
    rdfs:label "Code generation concept"@en ;
    rdfs:subClassOf :MetaprogrammingConcept ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "A language concept concerning the automatic generation of source code or other executable code from higher-level specifications, models, templates, or programs."@en .

:CodeInspection a tbox:ConceptualEntity ;
    rdfs:label "Code inspection"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_inspection> ;
    rdfs:comment "A verification activity in which software source code or program artifacts are systematically examined to identify defects and ensure conformance with specified requirements and standards."@en .

:CodeReview a tbox:ConceptualEntity ;
    rdfs:label "Code review"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :ImplementationActivity,
        :VerificationEngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Code_review> ;
    rdfs:comment "An implementation and verification activity in which source code is systematically examined to identify defects, improve quality, and ensure compliance with standards."@en .

:Coding a tbox:ConceptualEntity ;
    rdfs:label "Coding"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    rdfs:subClassOf :Implementation ;
    foaf:page <https://en.wikipedia.org/wiki/Computer_programming> ;
    rdfs:comment "An implementation activity concerned with writing source code to produce program artifacts, using programming languages and supporting tools such as compilers and interpreters."@en .

:ComplianceManagement a tbox:ConceptualEntity ;
    rdfs:label "Compliance management"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Regulatory_compliance> ;
    rdfs:comment "Engineering activity concerned with ensuring that software, systems, and development processes adhere to applicable regulations, standards, policies, and other compliance requirements."@en .

:ConcurrencyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Concurrency concept"@en ;
        rdfs:comment "A primitive language concept concerning the structuring and coordination of computations that may execute concurrently."@en .

:ConfigurationManagementPlanning a tbox:ConceptualEntity ;
    rdfs:label "Configuration management planning"@en ;
    rdfs:subClassOf :PlanningActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_management> ;
    rdfs:comment "An engineering activity concerned with planning and establishing the processes, responsibilities, resources, and procedures for managing configuration items and controlling changes throughout a software project's lifecycle."@en .

:ConstraintConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Constraint concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning the specification and enforcement of conditions or restrictions that valid programs, models, or data must satisfy."@en .

:ContinuousDelivery a tbox:ConceptualEntity ;
    rdfs:label "Continuous delivery"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_delivery> ;
    rdfs:comment "An engineering activity in which software changes are kept in a deployable state and released to production through automated, repeatable delivery processes."@en .

:ContinuousDeployment a tbox:ConceptualEntity ;
    rdfs:label "Continuous deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_deployment> ;
    rdfs:comment "A software engineering practice in which code changes are automatically released to production after successfully passing the required automated tests and deployment pipeline stages."@en .

:ContinuousIntegration a tbox:ConceptualEntity ;
    rdfs:label "Continuous integration"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_integration> ;
    rdfs:comment "An engineering activity in which developers frequently integrate code changes into a shared repository, with automated builds and tests used to detect integration issues early."@en .

:ControlConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Control concept"@en ;
        rdfs:comment "A primitive language concept concerned with directing the order and conditions under which computations are executed, such as through branching, iteration, recursion, sequencing, continuations, coroutines, or backtracking."@en .

:DataConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Data concept"@en ;
        rdfs:comment "A primitive language concept concerning the representation, organization, and manipulation of data, including data types and data structures."@en .

:DataModelDesign a tbox:ConceptualEntity ;
    rdfs:label "Data model design"@en ;
    tbox:hasSupportingLanguage le:DataDefinitionLanguage,
        le:OntologyLanguage,
        le:SemanticDataModelLanguage ;
    tbox:uses fe:DataManagementApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Data_model> ;
    rdfs:comment "The engineering activity of designing data models that define the structure, relationships, constraints, and semantics of data for use in information systems."@en .

:DependencyManagement a tbox:ConceptualEntity ;
    rdfs:label "Dependency management"@en ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Package_manager> ;
    rdfs:comment "An implementation activity concerned with declaring, resolving, organizing, and maintaining the external software packages or libraries required by a project."@en .

:Deployment a tbox:ConceptualEntity ;
    rdfs:label "Deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_deployment> ;
    rdfs:comment "An engineering activity that makes a software system available for use in a target environment."@en .

:DesignActivity a tbox:ConceptualEntity ;
    rdfs:label "Design activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software engineering activity concerned with defining a system's structure, components, interfaces, and other characteristics to satisfy specified requirements."@en .

:DesignValidation a tbox:ConceptualEntity ;
    rdfs:label "Design validation"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "An engineering activity that assesses whether a software design satisfies its specified requirements and intended purpose."@en .

:DevOpsPractice a tbox:ConceptualEntity ;
    rdfs:label "DevOps practice"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/DevOps> ;
    rdfs:comment "A software engineering practice that integrates and coordinates software development and IT operations to support the continuous delivery, deployment, and operation of software systems."@en .

:Documentation a tbox:ConceptualEntity ;
    rdfs:label "Documentation"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Documentation> ;
    rdfs:comment "An engineering activity concerned with creating, maintaining, and managing documentation for software systems and their related artifacts."@en .

:EffectConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Effect concept"@en ;
        rdfs:comment "A primitive language concept that characterizes observable computational effects, such as state changes, input/output, or exceptions."@en .

:EffortEstimation a tbox:ConceptualEntity ;
    rdfs:label "Effort estimation"@en ;
    rdfs:subClassOf :PlanningActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_development_effort_estimation> ;
    rdfs:comment "An engineering activity that estimates the effort, typically in terms of time, cost, and resources, required to complete a software development project or task."@en .

:EnvironmentProvisioning a tbox:ConceptualEntity ;
    rdfs:label "Environment provisioning"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Provisioning> ;
    rdfs:comment "A support activity that prepares, configures, and makes computing environments and required resources available for software development, deployment, or operation."@en .

:ErrorHandlingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Error handling concept"@en ;
        rdfs:comment "A primitive language concept concerning mechanisms and approaches for detecting, representing, managing, and recovering from errors or exceptional conditions during program execution."@en .

:EvaluationStrategyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Evaluation strategy concept"@en ;
        rdfs:comment "A primitive language concept that classifies strategies for determining when and how expressions or function arguments are evaluated."@en .

:EvolutionActivity a tbox:ConceptualEntity ;
    rdfs:label "Evolution activity"@en ;
    rdfs:comment "An engineering activity concerned with changing, adapting, or maintaining a software system over its lifetime."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_evolution> .

:ImprovementActivity a tbox:ConceptualEntity ;
    rdfs:label "Improvement activity"@en ;
    rdfs:comment "An engineering activity intended to improve the capabilities, quality, maintainability, or technical condition of a software system."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:Experimentation a tbox:ConceptualEntity ;
    rdfs:label "Experimentation"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Experiment> ;
    rdfs:comment "A support activity involving the systematic conduct of experiments to evaluate hypotheses, techniques, tools, or software-language-related artifacts."@en .

:FeatureEnhancement a tbox:ConceptualEntity ;
    rdfs:label "Feature enhancement"@en ;
    rdfs:subClassOf :ImprovementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_evolution> ;
    rdfs:comment "Software evolution activity that adds new functionality or improves existing features to meet changing user needs or requirements."@en .

:FormalVerification a tbox:ConceptualEntity ;
    rdfs:label "Formal verification"@en ;
    tbox:hasInputArtifact ae:ModelArtifact,
        ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelingLanguage,
        le:ProofLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ProofAssistant ;
    tbox:uses fe:FormalSemanticsApproach,
        fe:ProgramLogic,
        fe:TypeTheory ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Formal_verification> ;
    rdfs:comment "An engineering activity that establishes, using formal methods, whether a program or model satisfies specified correctness properties."@en .

:GrammarConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Grammar concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept representing the notion of a grammar: a formal specification of the syntactic structure of a language."@en .

:HigherOrderConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Higher-order concept"@en ;
        rdfs:comment "A language concept characterized by entities that can operate on, abstract over, or be parameterized by other entities of the same general kind, such as functions, modules, or types."@en .

:HighLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "High-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software design activity that defines the overall architecture, major components, and high-level structure of a software system."@en .

:Implementation a tbox:ConceptualEntity ;
    rdfs:label "Implementation"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "An engineering activity that realizes a software design by producing an executable program, typically using programming languages and tools such as compilers or interpreters."@en .

:ImplementationActivity a tbox:ConceptualEntity ;
    rdfs:label "Implementation activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "A software engineering activity concerned with implementing software systems, including programming, build scripting, dependency management, code review, and refactoring."@en .

:IncidentManagement a tbox:ConceptualEntity ;
    rdfs:label "Incident management"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Incident_management> ;
    rdfs:comment "An operations and maintenance activity that manages the lifecycle of incidents, including their identification, recording, analysis, resolution, and closure."@en .

:IntegrationTesting a tbox:ConceptualEntity ;
    rdfs:label "Integration testing"@en ;
    rdfs:subClassOf :VerificationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Integration_testing> ;
    rdfs:comment "A verification testing activity that evaluates the interactions and interfaces among integrated software components or subsystems."@en .

:InterfaceDesign a tbox:ConceptualEntity ;
    rdfs:label "Interface design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Interface_(computing)> ;
    rdfs:comment "Engineering activity concerned with designing the interfaces through which software components, systems, or users interact."@en .

:KnowledgeManagement a tbox:ConceptualEntity ;
    rdfs:label "Knowledge management"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Knowledge_management> ;
    rdfs:comment "A support activity concerned with creating, organizing, sharing, and using knowledge within an organization or project."@en .

:KnowledgeRepresentationConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Knowledge-representation concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "concept concerning the representation of knowledge in a form that can be processed, interpreted, and reasoned over by software systems"@en .

:LifetimeConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Lifetime concept"@en ;
        rdfs:comment "A primitive language concept that characterizes the duration for which a program object, resource, or allocated memory remains valid or accessible."@en .

:Logging a tbox:ConceptualEntity ;
    rdfs:label "Logging"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Logging_(computing)> ;
    rdfs:comment "Software engineering activity of recording events, messages, and other runtime information generated by a software system to support monitoring, diagnosis, and maintenance."@en .

:LowLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "Low-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A design activity concerned with specifying the detailed internal structure, components, interfaces, and implementation-level behavior of a software system."@en .

:MetaprogrammingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Metaprogramming concept"@en ;
        rdfs:comment "A language concept concerning techniques in which programs generate, manipulate, analyze, or modify other programs or themselves."@en .

:Migration a tbox:ConceptualEntity ;
    rdfs:label "Migration"@en ;
    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Migration_(software)> ;
    rdfs:comment "An evolution and improvement activity that moves software, its data, or its execution environment from one platform, technology, or system to another."@en .

:ModelingConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Modeling concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning the representation, construction, and use of models to describe systems, their structure, behavior, or other aspects of a domain."@en .

:ModularityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Modularity concept"@en ;
        rdfs:comment "A primitive language concept concerned with decomposing a software system into separate, cohesive, and independently manageable parts, such as modules, packages, namespaces, interfaces, and contracts."@en .

:Monitoring a tbox:ConceptualEntity ;
    rdfs:label "Monitoring"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/System_monitoring> ;
    rdfs:comment "An operations and maintenance activity that observes the status, performance, and behavior of software systems to detect issues and support their continued operation."@en .

:MutabilityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Mutability concept"@en ;
        rdfs:comment "A primitive language concept concerning whether data or objects can be modified after their creation, including mutable and immutable data and value versus reference semantics."@en .

:OperationsActivity a tbox:ConceptualEntity ;
    rdfs:label "Operations activity"@en ;
    rdfs:comment "An engineering activity concerned with operating, monitoring, and managing software systems in production."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:MaintenanceActivity a tbox:ConceptualEntity ;
    rdfs:label "Maintenance activity"@en ;
    rdfs:comment "An engineering activity concerned with modifying, correcting, recovering, or improving software after its deployment."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_maintenance> .

:Packaging a tbox:ConceptualEntity ;
    rdfs:label "Packaging"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_packaging> ;
    rdfs:comment "The software engineering activity of preparing software and its dependencies for distribution and installation."@en .

:ParadigmConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Paradigm concept"@en ;
        rdfs:comment "A primitive language concept that characterizes a general style or approach to computation and program evaluation, such as declarative, imperative, functional, logic, or object-oriented programming."@en .

:ParallelismConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Parallelism concept"@en ;
        rdfs:comment "A primitive language concept concerning the execution of multiple computations concurrently or simultaneously."@en .

:Patching a tbox:ConceptualEntity ;
    rdfs:label "Patching"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Patch_(computing)> ;
    rdfs:comment "Software engineering activity of applying a patch to software in order to correct defects, address security vulnerabilities, or make other targeted updates."@en .

:PerformanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Performance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "A validation testing activity that evaluates a software system's responsiveness, throughput, scalability, stability, and resource utilization under a specified workload."@en .

:PerformanceTuning a tbox:ConceptualEntity ;
    rdfs:label "Performance tuning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "An operations and maintenance activity focused on improving a software system's performance, such as execution speed, responsiveness, throughput, or resource usage."@en .

:PlanningActivity a tbox:ConceptualEntity ;
    rdfs:label "Planning activity"@en ;
    rdfs:comment "An engineering activity concerned with defining objectives, plans, processes, estimates, or roadmaps for software development."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:ManagementActivity a tbox:ConceptualEntity ;
    rdfs:label "Management activity"@en ;
    rdfs:comment "An engineering activity concerned with directing, coordinating, allocating resources, or managing risks and stakeholders in software development."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_project_management> .

:PrimitiveConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Primitive concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept that represents a fundamental category of programming-language concepts, such as abstraction, binding, control, data, scope, state, or types."@en .

