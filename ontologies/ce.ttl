    rdfs:subClassOf :RequirementsEngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Requirements_engineering> ;
    rdfs:comment "Requirements engineering activity that evaluates and ranks requirements according to criteria such as stakeholder value, cost, risk, and urgency to determine their implementation order."@en .

:RequirementsSpecification a tbox:ConceptualEntity ;
