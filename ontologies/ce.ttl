    rdfs:subClassOf :RequirementsEngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Requirements_engineering> ;
    rdfs:comment "Requirements engineering activity concerned with checking that specified requirements are correct, complete, consistent, feasible, and aligned with stakeholder needs."@en .

:ResourceAllocation a tbox:ConceptualEntity ;
