    rdfs:subClassOf :PlanningActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_development_process> ;
    rdfs:comment "An engineering activity concerned with defining and documenting the processes, activities, roles, and procedures used in software development or management."@en .

