@prefix : <http://www.softlang.org/ontologies/ce#> .
@prefix ae: <http://www.softlang.org/ontologies/ae#> .
@prefix fe: <http://www.softlang.org/ontologies/fe#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix le: <http://www.softlang.org/ontologies/le#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <http://www.softlang.org/ontologies/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .
@prefix te: <http://www.softlang.org/ontologies/te#> .

<http://www.softlang.org/ontologies/ce> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Sub-ontology / ABox for conceptual entities"@en,
        "This module also hosts the reusable language-concept framework used across software-language modules."@en ;
    owl:imports <http://www.softlang.org/ontologies/tbox> .

:AbstractionConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Abstraction concept"@en ;
        rdfs:comment "A primitive language concept that groups mechanisms for suppressing irrelevant implementation details and exposing an essential interface or representation, such as data, procedural, functional, module, and type abstraction."@en .

:AcceptanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Acceptance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Acceptance_testing> ;
    rdfs:comment "A validation testing activity that evaluates whether a software system satisfies specified acceptance criteria and is ready for delivery or use by its intended users or stakeholders."@en .

:APIDesign a tbox:ConceptualEntity ;
    rdfs:label "API design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :InterfaceDesign ;
    foaf:page <https://en.wikipedia.org/wiki/API> ;
    rdfs:comment "The software engineering activity of designing an application programming interface (API), including the specification of its operations, data structures, and interaction contracts."@en .

:Auditing a tbox:ConceptualEntity ;
    rdfs:label "Auditing"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Audit> ;
    rdfs:comment "An engineering activity that systematically examines software processes, products, or related records to assess compliance, quality, and adherence to established standards or policies."@en .

:Backup a tbox:ConceptualEntity ;
    rdfs:label "Backup"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Backup> .

:Recovery a tbox:ConceptualEntity ;
    rdfs:label "Recovery"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Data_recovery> .

:BindingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Binding concept"@en ;
        rdfs:comment "A primitive language concept concerning the association of names with program entities and the time at which such associations are established."@en .

:BugFixing a tbox:ConceptualEntity ;
    rdfs:label "Bug fixing"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_bug> ;
    rdfs:comment "Software engineering activity concerned with identifying, diagnosing, and correcting defects (bugs) in software."@en .

:BuildScripting a tbox:ConceptualEntity ;
    rdfs:label "Build scripting"@en ;
    tbox:hasOutputArtifact ae:BuildScriptArtifact ;
    tbox:hasSupportingLanguage le:BuildScriptingLanguage ;
    tbox:hasSupportingTool te:BuildTool ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> ;
    rdfs:comment "An implementation activity that defines and maintains build scripts to automate the building of software artifacts."@en .

:CapacityPlanning a tbox:ConceptualEntity ;
    rdfs:label "Capacity planning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Capacity_management> ;
    rdfs:comment "An operations and maintenance activity that determines and manages the resources required to meet current and anticipated workload demands."@en .

:ChangeManagement a tbox:ConceptualEntity ;
    rdfs:label "Change management"@en ;
    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Change_management> ;
    rdfs:comment "An engineering activity concerned with planning, coordinating, and controlling changes to software systems, their artifacts, and related development processes."@en .

:CodeGeneration a tbox:ConceptualEntity ;
    rdfs:label "Code generation"@en ;
    tbox:hasInputArtifact ae:GrammarArtifact,
        ae:ModelArtifact ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelTransformationLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ModelTransformationEngine ;
    tbox:uses fe:MetaprogrammingApproach ;
    rdfs:subClassOf :Implementation ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "An implementation activity that automatically transforms grammar or model artifacts into program artifacts, typically using programming or model transformation languages and supporting tools."@en .

:CodeGenerationConcept a tbox:ConceptualEntity ;
    rdfs:label "Code generation concept"@en ;
    rdfs:subClassOf :MetaprogrammingConcept ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "A language concept concerning the automatic generation of executable code or other program artifacts from higher-level specifications, models, templates, or source representations."@en .

:CodeInspection a tbox:ConceptualEntity ;
    rdfs:label "Code inspection"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_inspection> ;
    rdfs:comment "A verification activity in which source code is systematically examined to identify defects and assess its conformance to specified requirements and standards."@en .

:CodeReview a tbox:ConceptualEntity ;
    rdfs:label "Code review"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :ImplementationActivity,
        :VerificationEngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Code_review> ;
    rdfs:comment "An engineering activity in which source code is systematically examined to identify defects, improve quality, and ensure compliance with standards and requirements."@en .

:Coding a tbox:ConceptualEntity ;
    rdfs:label "Coding"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    rdfs:subClassOf :Implementation ;
    foaf:page <https://en.wikipedia.org/wiki/Computer_programming> ;
    rdfs:comment "An implementation activity that translates software design decisions into program code using programming languages and supporting tools."@en .

:ComplianceManagement a tbox:ConceptualEntity ;
    rdfs:label "Compliance management"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Regulatory_compliance> ;
    rdfs:comment "An engineering activity concerned with ensuring that software systems, development processes, and related artifacts comply with applicable regulations, standards, policies, and other requirements."@en .

:ConcurrencyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Concurrency concept"@en ;
        rdfs:comment "A primitive language concept concerning the structuring and coordination of multiple computations that may progress during overlapping periods of time."@en .

:ConfigurationManagementPlanning a tbox:ConceptualEntity ;
    rdfs:label "Configuration management planning"@en ;
    rdfs:subClassOf :ManagementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_management> ;
    rdfs:comment "An engineering activity that establishes and maintains plans for identifying, controlling, recording, and auditing changes to software configuration items throughout their lifecycle."@en .

:ConstraintConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Constraint concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning the specification of conditions or restrictions that valid programs, models, data, or other language artifacts must satisfy."@en .

:ContinuousDelivery a tbox:ConceptualEntity ;
    rdfs:label "Continuous delivery"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_delivery> ;
    rdfs:comment "An engineering activity that ensures software changes are built, tested, and kept in a deployable state so they can be released to production frequently and reliably."@en .

:ContinuousDeployment a tbox:ConceptualEntity ;
    rdfs:label "Continuous deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_deployment> ;
    rdfs:comment "A software engineering practice in which code changes are automatically released to production after passing the required validation and testing stages."@en .

:ContinuousIntegration a tbox:ConceptualEntity ;
    rdfs:label "Continuous integration"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_integration> ;
    rdfs:comment "A software engineering practice in which code changes are frequently integrated into a shared repository and automatically built and tested."@en .

:ControlConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Control concept"@en ;
        rdfs:comment "A primitive language concept concerned with directing the order and conditions under which computations are executed, such as sequencing, branching, iteration, recursion, backtracking, continuations, and coroutines."@en .

:DataConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Data concept"@en ;
        rdfs:comment "A primitive language concept concerning the representation, organization, and manipulation of data, including data types and data structures."@en .

:DataModelDesign a tbox:ConceptualEntity ;
    rdfs:label "Data model design"@en ;
    tbox:hasSupportingLanguage le:DataDefinitionLanguage,
        le:OntologyLanguage,
        le:SemanticDataModelLanguage ;
    tbox:uses fe:DataManagementApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Data_model> ;
    rdfs:comment "The engineering activity of designing data models that define the structure, relationships, and constraints of data for a system or application."@en .

:DependencyManagement a tbox:ConceptualEntity ;
    rdfs:label "Dependency management"@en ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Package_manager> ;
    rdfs:comment "An implementation activity concerned with declaring, resolving, versioning, and maintaining the external software packages or libraries required by a project."@en .

:Deployment a tbox:ConceptualEntity ;
    rdfs:label "Deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_deployment> ;
    rdfs:comment "An engineering activity concerned with making a software system available for use in a target environment."@en .

:DesignActivity a tbox:ConceptualEntity ;
    rdfs:label "Design activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "An engineering activity concerned with defining the structure, components, interfaces, and other characteristics of a software system or artifact before implementation."@en .

:DesignValidation a tbox:ConceptualEntity ;
    rdfs:label "Design validation"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "Software engineering activity that assesses whether a software design satisfies its specified requirements and intended purpose."@en .

:DevOpsPractice a tbox:ConceptualEntity ;
    rdfs:label "DevOps practice"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/DevOps> ;
    rdfs:comment "A software engineering practice that integrates software development and IT operations to support collaboration, automation, and continuous delivery throughout the software lifecycle."@en .

:Documentation a tbox:ConceptualEntity ;
    rdfs:label "Documentation"@en ;
    rdfs:subClassOf :QualityActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Documentation> ;
    rdfs:comment "An engineering activity concerned with creating, maintaining, and managing documentation that describes software systems, languages, tools, or related processes."@en .

:EffectConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Effect concept"@en ;
        rdfs:comment "A primitive language concept concerning computational effects, such as state changes, input/output, exceptions, or other observable interactions beyond pure computation."@en .

:EffortEstimation a tbox:ConceptualEntity ;
    rdfs:label "Effort estimation"@en ;
    rdfs:subClassOf :PlanningActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_development_effort_estimation> ;
    rdfs:comment "A planning and management activity that estimates the effort, typically in terms of time, cost, or person-hours, required to complete a software development project or task."@en .

:EnvironmentProvisioning a tbox:ConceptualEntity ;
    rdfs:label "Environment provisioning"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Provisioning> ;
    rdfs:comment "An engineering support activity that provides and configures the infrastructure, tools, resources, and environments needed to develop, test, deploy, or operate software systems."@en .

:ErrorHandlingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Error handling concept"@en ;
        rdfs:comment "A primitive language concept concerning mechanisms for detecting, signaling, propagating, and recovering from errors, including exceptions and option/result types."@en .

:EvaluationStrategyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Evaluation strategy concept"@en ;
        rdfs:comment "A primitive language concept that classifies strategies for determining the order and conditions under which expressions or function arguments are evaluated."@en .

:EvolutionActivity a tbox:ConceptualEntity ;
    rdfs:label "Evolution activity"@en ;
    rdfs:comment "An engineering activity concerned with adapting, maintaining, or otherwise evolving an existing software system over time."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_evolution> .

:ImprovementActivity a tbox:ConceptualEntity ;
    rdfs:label "Improvement activity"@en ;
    rdfs:comment "An engineering activity intended to improve the quality, capabilities, maintainability, or other properties of an existing software system."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:Experimentation a tbox:ConceptualEntity ;
    rdfs:label "Experimentation"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Experiment> ;
    rdfs:comment "A support activity that uses experiments to investigate, evaluate, or validate software languages, tools, methods, or related engineering hypotheses."@en .

:FeatureEnhancement a tbox:ConceptualEntity ;
    rdfs:label "Feature enhancement"@en ;
    rdfs:subClassOf :ImprovementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_evolution> ;
    rdfs:comment "An evolution and improvement activity that adds new capabilities or extends existing functionality in a software system."@en .

:FormalVerification a tbox:ConceptualEntity ;
    rdfs:label "Formal verification"@en ;
    tbox:hasInputArtifact ae:ModelArtifact,
        ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelingLanguage,
        le:ProofLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ProofAssistant ;
    tbox:uses fe:FormalSemanticsApproach,
        fe:ProgramLogic,
        fe:TypeTheory ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Formal_verification> ;
    rdfs:comment "A verification activity that uses mathematically rigorous methods to establish whether a program or model satisfies its formal specification."@en .

:GrammarConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Grammar concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning grammars, the formal rules and structures used to define the syntax of languages."@en .

:HigherOrderConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Higher-order concept"@en ;
        rdfs:comment "A language concept concerning entities that can be treated as values, passed as arguments, returned as results, or otherwise abstracted over."@en .

:HighLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "High-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software design activity that defines the overall architecture, major components, and their interactions without specifying detailed implementation."@en .

:Implementation a tbox:ConceptualEntity ;
    rdfs:label "Implementation"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "An engineering activity that realizes a software design by producing a program, typically using programming languages and tools such as compilers or interpreters."@en .

:ImplementationActivity a tbox:ConceptualEntity ;
    rdfs:label "Implementation activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "An engineering activity concerned with implementing software systems, including programming, build scripting, dependency management, code review, and refactoring."@en .

:IncidentManagement a tbox:ConceptualEntity ;
    rdfs:label "Incident management"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Incident_management> ;
    rdfs:comment "An operations and maintenance activity concerned with managing the lifecycle of incidents, including their identification, response, resolution, and restoration of affected services."@en .

:IntegrationTesting a tbox:ConceptualEntity ;
    rdfs:label "Integration testing"@en ;
    rdfs:subClassOf :VerificationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Integration_testing> ;
    rdfs:comment "A verification testing activity that evaluates the interactions and interfaces among integrated software components or subsystems."@en .

:InterfaceDesign a tbox:ConceptualEntity ;
    rdfs:label "Interface design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Interface_(computing)> ;
    rdfs:comment "Engineering activity concerned with designing and specifying the interfaces through which software components, systems, or services interact."@en .

:KnowledgeManagement a tbox:ConceptualEntity ;
    rdfs:label "Knowledge management"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Knowledge_management> ;
    rdfs:comment "The systematic process of creating, organizing, sharing, and using knowledge to support organizational activities and decision-making."@en .

:KnowledgeRepresentationConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Knowledge-representation concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "concept concerning the representation of knowledge in a form that enables semantic interpretation, querying, and reasoning"@en .

:LifetimeConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Lifetime concept"@en ;
        rdfs:comment "A programming-language concept that characterizes the period during which a memory allocation or object remains valid and available for use."@en .

:Logging a tbox:ConceptualEntity ;
    rdfs:label "Logging"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Logging_(computing)> ;
    rdfs:comment "An operations and maintenance activity that records events, messages, or system behavior to support monitoring, diagnosis, auditing, and troubleshooting."@en .

:LowLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "Low-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software design activity that specifies the detailed internal structure, components, algorithms, data structures, and interfaces needed to implement a system."@en .

:MetaprogrammingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Metaprogramming concept"@en ;
        rdfs:comment "A language concept related to metaprogramming, in which programs manipulate, generate, analyze, or transform other programs or themselves."@en .

:Migration a tbox:ConceptualEntity ;
    rdfs:label "Migration"@en ;
    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Migration_(software)> ;
    rdfs:comment "An evolution and improvement activity that moves a software system, its data, or its execution environment from one platform, technology, or version to another."@en .

:ModelingConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Modeling concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning the representation, construction, and use of models to describe systems or domains."@en .

:ModularityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Modularity concept"@en ;
        rdfs:comment "A primitive language concept concerning the decomposition and organization of software into separate, cohesive, and independently manageable units."@en .

:Monitoring a tbox:ConceptualEntity ;
    rdfs:label "Monitoring"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/System_monitoring> ;
    rdfs:comment "An operations and maintenance activity that observes a software system, its infrastructure, or its operational environment to collect and analyze information about its status, behavior, and performance."@en .

:MutabilityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Mutability concept"@en ;
        rdfs:comment "A primitive language concept concerning whether data or objects can be modified after they are created, including mutability, immutability, and reference or value semantics."@en .

:OperationsActivity a tbox:ConceptualEntity ;
    rdfs:label "Operations activity"@en ;
    rdfs:comment "An engineering activity concerned with operating, observing, and managing a deployed software system or its execution environment."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:MaintenanceActivity a tbox:ConceptualEntity ;
    rdfs:label "Maintenance activity"@en ;
    rdfs:comment "An engineering activity concerned with modifying, repairing, recovering, or improving a software system after its delivery."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_maintenance> .

:Packaging a tbox:ConceptualEntity ;
    rdfs:label "Packaging"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_packaging> ;
    rdfs:comment "The software engineering activity of preparing software and its dependencies for distribution, installation, deployment, or release."@en .

:ParadigmConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Paradigm concept"@en ;
        rdfs:comment "A primitive language concept that characterizes a fundamental style or model of computation, such as declarative, imperative, functional, logic, or object-oriented programming."@en .

:ParallelismConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Parallelism concept"@en ;
        rdfs:comment "A primitive language concept concerning the simultaneous execution of multiple computations, such as data, task, or pipeline parallelism."@en .

:Patching a tbox:ConceptualEntity ;
    rdfs:label "Patching"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Patch_(computing)> ;
    rdfs:comment "An operations and maintenance activity that applies a patch to software to correct defects, address security vulnerabilities, or make minor updates."@en .

:PerformanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Performance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "A validation testing activity that evaluates a software system's responsiveness, throughput, scalability, stability, and resource utilization under a specified workload."@en .

:PerformanceTuning a tbox:ConceptualEntity ;
    rdfs:label "Performance tuning"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "An operations and maintenance activity aimed at improving the runtime performance, efficiency, or resource utilization of a software system."@en .

:PlanningActivity a tbox:ConceptualEntity ;
    rdfs:label "Planning activity"@en ;
    rdfs:comment "An engineering activity concerned with preparing, defining, or organizing intended future work, resources, processes, or project directions."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:ManagementActivity a tbox:ConceptualEntity ;
    rdfs:label "Management activity"@en ;
    rdfs:comment "An engineering activity concerned with directing, coordinating, controlling, or administering project work, resources, risks, configurations, or stakeholders."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_project_management> .

:PrimitiveConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Primitive concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
