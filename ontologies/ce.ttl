@prefix : <http://www.softlang.org/ontologies/ce#> .
@prefix ae: <http://www.softlang.org/ontologies/ae#> .
@prefix fe: <http://www.softlang.org/ontologies/fe#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix le: <http://www.softlang.org/ontologies/le#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <http://www.softlang.org/ontologies/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .
@prefix te: <http://www.softlang.org/ontologies/te#> .

<http://www.softlang.org/ontologies/ce> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Sub-ontology / ABox for conceptual entities"@en,
        "This module also hosts the reusable language-concept framework used across software-language modules."@en ;
    owl:imports <http://www.softlang.org/ontologies/tbox> .

:AbstractionConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Abstraction concept"@en ;
        rdfs:comment "A primitive language concept that groups mechanisms for hiding implementation details and exposing essential properties or interfaces."@en .

:AcceptanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Acceptance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Acceptance_testing> ;
    rdfs:comment "A validation testing activity that evaluates whether a software system satisfies specified acceptance criteria and is ready for delivery or use by its intended users or stakeholders."@en .

:APIDesign a tbox:ConceptualEntity ;
    rdfs:label "API design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :InterfaceDesign ;
    foaf:page <https://en.wikipedia.org/wiki/API> ;
    rdfs:comment "The software engineering activity of designing an application programming interface (API), including the definition of its operations, data structures, interaction rules, and intended usage."@en .

:Auditing a tbox:ConceptualEntity ;
    rdfs:label "Auditing"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Audit> ;
    rdfs:comment "A quality and governance activity that systematically examines software artifacts, processes, or practices to assess their compliance with specified requirements, standards, or policies."@en .

:Backup a tbox:ConceptualEntity ;
    rdfs:label "Backup"@en ;
    rdfs:comment "An operations and maintenance activity that creates a copy of data or system state so that it can be restored if necessary."@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Backup> .

:DataRecovery a tbox:ConceptualEntity ;
    rdfs:label "Data recovery"@en ;
    rdfs:comment "An operations and maintenance activity that restores or retrieves data after loss, corruption, or failure."@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Data_recovery> .

:BindingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Binding concept"@en ;
        rdfs:comment "A primitive language concept concerning the association of names or other identifiers with entities, values, locations, or attributes, including the time at which such associations are established."@en .

:BugFixing a tbox:ConceptualEntity ;
    rdfs:label "Bug fixing"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_bug> ;
    rdfs:comment "An operations and maintenance activity concerned with identifying, correcting, and verifying fixes for software defects (bugs)."@en .

:BuildScripting a tbox:ConceptualEntity ;
    rdfs:label "Build scripting"@en ;
    tbox:hasOutputArtifact ae:BuildScriptArtifact ;
    tbox:hasSupportingLanguage le:BuildScriptingLanguage ;
    tbox:hasSupportingTool te:BuildTool ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> ;
    rdfs:comment "An implementation activity that defines and maintains build scripts to automate the building of software artifacts."@en .

:CapacityPlanning a tbox:ConceptualEntity ;
    rdfs:label "Capacity planning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Capacity_management> ;
    rdfs:comment "An operations and maintenance activity that assesses and plans the resources required to meet current and anticipated workload and performance demands."@en .

:ChangeManagement a tbox:ConceptualEntity ;
    rdfs:label "Change management"@en ;
    rdfs:subClassOf :SoftwareEvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Change_management> ;
    rdfs:comment "A software engineering activity concerned with planning, controlling, and implementing changes to software systems, processes, or related artifacts."@en .

:CodeGeneration a tbox:ConceptualEntity ;
    rdfs:label "Code generation"@en ;
    tbox:hasInputArtifact ae:GrammarArtifact,
        ae:ModelArtifact ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelTransformationLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ModelTransformationEngine ;
    tbox:uses fe:MetaprogrammingApproach ;
    rdfs:subClassOf :Implementation ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "An implementation activity that transforms grammar or model artifacts into program artifacts, typically using programming or model transformation languages and supporting tools."@en .

:CodeGenerationConcept a tbox:ConceptualEntity ;
    rdfs:label "Code generation concept"@en ;
    rdfs:subClassOf :MetaprogrammingConcept ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "A language concept concerning the automatic production of source code or other executable code, typically from higher-level specifications, models, templates, or programs."@en .

:CodeInspection a tbox:ConceptualEntity ;
    rdfs:label "Code inspection"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_inspection> ;
    rdfs:comment "A verification activity in which software source code or program artifacts are systematically examined to identify defects and ensure compliance with specified requirements and standards."@en .

:CodeReview a tbox:ConceptualEntity ;
    rdfs:label "Code review"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :ImplementationActivity,
        :VerificationAndValidationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Code_review> ;
    rdfs:comment "An engineering activity in which source code is systematically examined to identify defects, improve quality, and verify compliance with standards and requirements."@en .

:Coding a tbox:ConceptualEntity ;
    rdfs:label "Coding"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    rdfs:subClassOf :Implementation ;
    foaf:page <https://en.wikipedia.org/wiki/Computer_programming> ;
    rdfs:comment "An implementation activity that creates program artifacts by expressing software instructions in a programming language, typically with support from compilers or interpreters."@en .

:ComplianceManagement a tbox:ConceptualEntity ;
    rdfs:label "Compliance management"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Regulatory_compliance> ;
    rdfs:comment "An engineering activity concerned with ensuring that software systems, processes, and associated artifacts conform to applicable regulatory, legal, contractual, and organizational requirements."@en .

:ConcurrencyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Concurrency concept"@en ;
        rdfs:comment "A primitive language concept concerning the execution and coordination of multiple computational activities that may overlap in time."@en .

:ConfigurationManagementPlanning a tbox:ConceptualEntity ;
    rdfs:label "Configuration management planning"@en ;
    rdfs:subClassOf :ManagementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_management> ;
    rdfs:comment "An engineering activity concerned with planning how software configuration items, versions, changes, and related configuration management processes are identified, controlled, and managed."@en .

:ConstraintConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Constraint concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept for specifying conditions, restrictions, or relationships that valid programs, models, or data must satisfy."@en .

:ContinuousDelivery a tbox:ConceptualEntity ;
    rdfs:label "Continuous delivery"@en ;
    rdfs:subClassOf :ContinuousDeliveryPipelineActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_delivery> ;
    rdfs:comment "A software engineering practice in which code changes are kept ready for release through automated building, testing, and deployment processes."@en .

:ContinuousDeployment a tbox:ConceptualEntity ;
    rdfs:label "Continuous deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_deployment> ;
    rdfs:comment "A software engineering practice in which code changes that pass automated validation are automatically released to production."@en .

:ContinuousIntegration a tbox:ConceptualEntity ;
    rdfs:label "Continuous integration"@en ;
    rdfs:subClassOf :ContinuousDeliveryPipelineActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_integration> ;
    rdfs:comment "A software engineering practice in which code changes are frequently integrated into a shared repository and automatically built and tested."@en .

:ControlConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Control concept"@en ;
        rdfs:comment "A primitive language concept concerning mechanisms that determine the order in which computations or program statements are executed, such as branching, iteration, recursion, and continuations."@en .

:DataConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Data concept"@en ;
        rdfs:comment "A primitive language concept concerned with data and data structures, including primitive values, collections, records, tuples, variants, references, and recursive data."@en .

:DataModelDesign a tbox:ConceptualEntity ;
    rdfs:label "Data model design"@en ;
    tbox:hasSupportingLanguage le:DataDefinitionLanguage,
        le:OntologyLanguage,
        le:SemanticDataModelLanguage ;
    tbox:uses fe:DataManagementApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Data_model> ;
    rdfs:comment "The engineering activity of designing a data model that defines the structure, relationships, and constraints of data for a software system or information domain."@en .

:DependencyManagement a tbox:ConceptualEntity ;
    rdfs:label "Dependency management"@en ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Package_manager> ;
    rdfs:comment "An implementation activity concerned with declaring, resolving, updating, and maintaining the external software dependencies required by a project."@en .

:Deployment a tbox:ConceptualEntity ;
    rdfs:label "Deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_deployment> ;
    rdfs:comment "An engineering activity that makes a software system available for use in a target environment."@en .

:DesignActivity a tbox:ConceptualEntity ;
    rdfs:label "Design activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "An engineering activity that defines and plans the structure, components, interfaces, and other characteristics of a software system or artifact."@en .

:DesignValidation a tbox:ConceptualEntity ;
    rdfs:label "Design validation"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "The activity of evaluating a software design to determine whether it satisfies its specified requirements and intended purpose."@en .

:DevOpsPractice a tbox:ConceptualEntity ;
    rdfs:label "DevOps practice"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/DevOps> ;
    rdfs:comment "A support activity that integrates software development and IT operations practices to improve collaboration, automation, and the delivery and operation of software systems."@en .

:Documentation a tbox:ConceptualEntity ;
    rdfs:label "Documentation"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Documentation> ;
    rdfs:comment "An engineering activity concerned with creating, maintaining, and managing documentation that describes software systems, languages, tools, or related processes."@en .

:EffectConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Effect concept"@en ;
        rdfs:comment "A primitive language concept concerning computational effects, namely observable interactions or changes beyond producing a return value, such as state updates, input/output, or exceptions."@en .

:EffortEstimation a tbox:ConceptualEntity ;
    rdfs:label "Effort estimation"@en ;
    rdfs:subClassOf :PlanningActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_development_effort_estimation> ;
    rdfs:comment "A planning and management activity that estimates the effort, typically in person-hours or person-days, required to complete a software development project or task."@en .

:EnvironmentProvisioning a tbox:ConceptualEntity ;
    rdfs:label "Environment provisioning"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Provisioning> ;
    rdfs:comment "A support activity concerned with preparing, configuring, and making the technical environments and resources required for software development, deployment, or operation available."@en .

:ErrorHandlingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Error handling concept"@en ;
        rdfs:comment "A primitive language concept concerning mechanisms for detecting, representing, and managing errors or exceptional conditions during program execution."@en .

:EvaluationStrategyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Evaluation strategy concept"@en ;
        rdfs:comment "A primitive language concept that classifies strategies governing when and how expressions or function arguments are evaluated during program execution."@en .

:SoftwareEvolutionActivity a tbox:ConceptualEntity ;
    rdfs:label "Software evolution activity"@en ;
    rdfs:comment "An engineering activity concerned with changing, adapting, or maintaining software systems over their lifetime."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_evolution> .

:SoftwareImprovementActivity a tbox:ConceptualEntity ;
    rdfs:label "Software improvement activity"@en ;
    rdfs:comment "An engineering activity intended to improve the quality, capabilities, maintainability, or value of a software system."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:Experimentation a tbox:ConceptualEntity ;
    rdfs:label "Experimentation"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Experiment> ;
    rdfs:comment "A support activity involving the systematic testing and evaluation of hypotheses, techniques, tools, or software artifacts to obtain empirical evidence."@en .

:FeatureEnhancement a tbox:ConceptualEntity ;
    rdfs:label "Feature enhancement"@en ;
    rdfs:subClassOf :SoftwareImprovementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_evolution> ;
    rdfs:comment "An evolution and improvement activity that adds new or enhanced functionality to an existing software system."@en .

:FormalVerification a tbox:ConceptualEntity ;
    rdfs:label "Formal verification"@en ;
    tbox:hasInputArtifact ae:ModelArtifact,
        ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelingLanguage,
        le:ProofLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ProofAssistant ;
    tbox:uses fe:FormalSemanticsApproach,
        fe:ProgramLogic,
        fe:TypeTheory ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Formal_verification> ;
    rdfs:comment "A verification activity that uses formal methods to mathematically establish that a program or model satisfies specified properties or requirements."@en .

:GrammarConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Grammar concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept that denotes the notions and constructs used to define the syntax of a language, typically by means of a formal grammar."@en .

:HigherOrderConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Higher-order concept"@en ;
        rdfs:comment "A language concept involving entities that operate on, abstract over, or are parameterized by other entities of the same kind, such as functions or modules."@en .

:HighLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "High-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software design activity concerned with defining the overall architecture, major components, and high-level structure of a software system."@en .

:Implementation a tbox:ConceptualEntity ;
    rdfs:label "Implementation"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "An engineering activity that realizes a software design by producing a program, typically using programming languages and tools such as compilers or interpreters."@en .

:ImplementationActivity a tbox:ConceptualEntity ;
    rdfs:label "Implementation activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "A type of software engineering activity concerned with implementing software systems or components, including programming, build scripting, dependency management, code review, and refactoring."@en .

:IncidentManagement a tbox:ConceptualEntity ;
    rdfs:label "Incident management"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Incident_management> ;
    rdfs:comment "An engineering activity concerned with managing the lifecycle of incidents, including their identification, response, resolution, and restoration of normal service."@en .

:IntegrationTesting a tbox:ConceptualEntity ;
    rdfs:label "Integration testing"@en ;
    rdfs:subClassOf :VerificationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Integration_testing> ;
    rdfs:comment "A verification and testing activity that evaluates the interactions and interfaces among integrated software components or subsystems."@en .

:InterfaceDesign a tbox:ConceptualEntity ;
    rdfs:label "Interface design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Interface_(computing)> ;
    rdfs:comment "The activity of designing interfaces that define how software components, systems, or users interact."@en .

:KnowledgeManagement a tbox:ConceptualEntity ;
    rdfs:label "Knowledge management"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Knowledge_management> ;
    rdfs:comment "The systematic process of creating, capturing, organizing, sharing, and effectively using knowledge within an organization."@en .

:KnowledgeRepresentationConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Knowledge-representation concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "concept concerning the representation of knowledge in a form that enables its expression, organization, sharing, and automated reasoning"@en .

:LifetimeConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Lifetime concept"@en ;
        rdfs:comment "A language concept that characterizes the period during which a resource, memory allocation, or object exists and remains valid."@en .

:Logging a tbox:ConceptualEntity ;
    rdfs:label "Logging"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Logging_(computing)> ;
    rdfs:comment "An operations and maintenance activity that records events, messages, or system state information to support monitoring, diagnosis, auditing, and troubleshooting."@en .

:LowLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "Low-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A design activity concerned with the detailed specification of software components, modules, data structures, interfaces, and algorithms needed for implementation."@en .

:MetaprogrammingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Metaprogramming concept"@en ;
        rdfs:comment "A language concept encompassing techniques in which programs generate, analyze, transform, or manipulate other programs or themselves."@en .

:Migration a tbox:ConceptualEntity ;
    rdfs:label "Migration"@en ;
    rdfs:subClassOf :SoftwareEvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Migration_(software)> ;
    rdfs:comment "An engineering activity that moves software systems, data, or applications from one environment, platform, technology, or version to another."@en .

:ModelingConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Modeling concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerned with the representation, abstraction, and specification of systems or domains through models."@en .

:ModularityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Modularity concept"@en ;
        rdfs:comment "A language concept concerning the decomposition of a software system or language into separate, cohesive, and composable units, such as modules, packages, namespaces, interfaces, and contracts."@en .

:Monitoring a tbox:ConceptualEntity ;
    rdfs:label "Monitoring"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/System_monitoring> ;
    rdfs:comment "An operations and maintenance activity that observes the status, performance, and behavior of a software system to detect issues and support its continued operation."@en .

:MutabilityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Mutability concept"@en ;
        rdfs:comment "A primitive language concept concerning whether data or objects can be modified after their creation, including mutable and immutable data and value or reference semantics."@en .

:OperationsActivity a tbox:ConceptualEntity ;
    rdfs:label "Operations activity"@en ;
    rdfs:comment "An engineering activity concerned with operating, observing, managing, and sustaining deployed software systems and their infrastructure."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:MaintenanceActivity a tbox:ConceptualEntity ;
    rdfs:label "Maintenance activity"@en ;
    rdfs:comment "An engineering activity concerned with modifying deployed software to correct faults, improve quality, or adapt it to changed requirements or environments."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_maintenance> .

:Packaging a tbox:ConceptualEntity ;
    rdfs:label "Packaging"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_packaging> ;
    rdfs:comment "The software engineering activity of preparing software and its associated resources for distribution, installation, or deployment."@en .

:ParadigmConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Paradigm concept"@en ;
        rdfs:comment "A primitive language concept that classifies software languages according to their fundamental computational approach or evaluation model."@en .

:ParallelismConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Parallelism concept"@en ;
        rdfs:comment "A primitive language concept concerning the simultaneous execution of multiple computations, including data, task, and pipeline parallelism."@en .

:Patching a tbox:ConceptualEntity ;
    rdfs:label "Patching"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Patch_(computing)> ;
    rdfs:comment "An operations and maintenance activity that modifies software by applying a patch, typically to correct defects, address security vulnerabilities, or make minor updates."@en .

:PerformanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Performance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "Testing activity that evaluates a software system's responsiveness, throughput, scalability, stability, and resource utilization under specified workloads."@en .

:PerformanceTuning a tbox:ConceptualEntity ;
    rdfs:label "Performance tuning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "An operations and maintenance activity focused on improving a software system's performance, such as its execution time, throughput, or resource utilization."@en .

:PlanningActivity a tbox:ConceptualEntity ;
    rdfs:label "Planning activity"@en ;
    rdfs:comment "An engineering activity concerned with planning software-development work, processes, or technological directions."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:ManagementActivity a tbox:ConceptualEntity ;
    rdfs:label "Management activity"@en ;
    rdfs:comment "An engineering activity concerned with managing software-development work, resources, risks, configurations, or stakeholders."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_project_management> .

