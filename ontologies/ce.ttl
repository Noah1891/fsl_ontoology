@prefix : <http://www.softlang.org/ontologies/ce#> .
@prefix ae: <http://www.softlang.org/ontologies/ae#> .
@prefix fe: <http://www.softlang.org/ontologies/fe#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix le: <http://www.softlang.org/ontologies/le#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <http://www.softlang.org/ontologies/pe#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .
@prefix te: <http://www.softlang.org/ontologies/te#> .

<http://www.softlang.org/ontologies/ce> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Sub-ontology / ABox for conceptual entities"@en,
        "This module also hosts the reusable language-concept framework used across software-language modules."@en ;
    owl:imports <http://www.softlang.org/ontologies/tbox> .

:AbstractionConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Abstraction concept"@en ;
        rdfs:comment "A primitive language concept that groups mechanisms for managing complexity by emphasizing essential characteristics while hiding implementation details."@en .

:AcceptanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Acceptance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Acceptance_testing> ;
    rdfs:comment "A validation testing activity in which a system is evaluated against acceptance criteria to determine whether it satisfies stakeholder or user requirements."@en .

:APIDesign a tbox:ConceptualEntity ;
    rdfs:label "API design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :InterfaceDesign ;
    foaf:page <https://en.wikipedia.org/wiki/API> ;
    rdfs:comment "The software engineering activity of designing an application programming interface (API), including the definition of its operations, data structures, and interaction contracts."@en .

:Auditing a tbox:ConceptualEntity ;
    rdfs:label "Auditing"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Audit> ;
    rdfs:comment "A quality and governance activity that systematically examines software-related processes, artifacts, or systems to assess compliance with specified requirements, standards, or policies."@en .

:Backup a tbox:ConceptualEntity ;
    rdfs:label "Backup"@en ;
    rdfs:comment "An operations and maintenance activity that creates a copy of data so that it can be restored if needed."@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Backup> .

:DataRecovery a tbox:ConceptualEntity ;
    rdfs:label "Data recovery"@en ;
    rdfs:comment "An operations and maintenance activity that restores or retrieves data that has been lost, damaged, or become inaccessible."@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Data_recovery> .

:BindingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Binding concept"@en ;
        rdfs:comment "A primitive language concept concerning the association of names with entities, including name binding and binding time."@en .

:BugFixing a tbox:ConceptualEntity ;
    rdfs:label "Bug fixing"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_bug> ;
    rdfs:comment "An operations and maintenance activity that identifies, diagnoses, and corrects defects in software."@en .

:BuildScripting a tbox:ConceptualEntity ;
    rdfs:label "Build scripting"@en ;
    tbox:hasOutputArtifact ae:BuildScriptArtifact ;
    tbox:hasSupportingLanguage le:BuildScriptingLanguage ;
    tbox:hasSupportingTool te:BuildTool ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Build_automation> ;
    rdfs:comment "An implementation activity that automates the building of software artifacts using build scripts, build tools, and build scripting languages."@en .

:CapacityPlanning a tbox:ConceptualEntity ;
    rdfs:label "Capacity planning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Capacity_management> ;
    rdfs:comment "An operations and maintenance activity that determines and manages the resources needed to meet current and anticipated workload demands."@en .

:ChangeManagement a tbox:ConceptualEntity ;
    rdfs:label "Change management"@en ;
    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Change_management> ;
    rdfs:comment "An engineering activity concerned with managing changes to software systems, their artifacts, and the processes affected by those changes."@en .

:CodeGeneration a tbox:ConceptualEntity ;
    rdfs:label "Code generation"@en ;
    tbox:hasInputArtifact ae:GrammarArtifact,
        ae:ModelArtifact ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelTransformationLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ModelTransformationEngine ;
    tbox:uses fe:MetaprogrammingApproach ;
    rdfs:subClassOf :Implementation ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "An implementation activity that automatically produces program artifacts from input artifacts such as models or grammars, typically using programming or model transformation languages and supporting tools."@en .

:CodeGenerationConcept a tbox:ConceptualEntity ;
    rdfs:label "Code generation concept"@en ;
    rdfs:subClassOf :MetaprogrammingConcept ;
    foaf:isPrimaryTopicOf <https://dbpedia.org/resource/Code_generation_(compiler)>,
        <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    foaf:page <https://en.wikipedia.org/wiki/Code_generation_(compiler)> ;
    rdfs:comment "A language concept concerned with automatically producing source code or other executable artifacts from higher-level specifications, models, templates, or programs."@en .

:CodeInspection a tbox:ConceptualEntity ;
    rdfs:label "Code inspection"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_inspection> ;
    rdfs:comment "A verification activity in which source code is systematically examined, typically by peers, to identify defects and deviations from standards without executing the program."@en .

:CodeReview a tbox:ConceptualEntity ;
    rdfs:label "Code review"@en ;
    tbox:hasInputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    rdfs:subClassOf :ImplementationActivity,
        :VerificationEngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Code_review> ;
    rdfs:comment "An engineering activity in which source code is systematically examined to identify defects, improve quality, and verify compliance with standards and requirements."@en .

:Coding a tbox:ConceptualEntity ;
    rdfs:label "Coding"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    rdfs:subClassOf :Implementation ;
    foaf:page <https://en.wikipedia.org/wiki/Computer_programming> ;
    rdfs:comment "An implementation activity that creates program code using programming languages and tools such as compilers or interpreters."@en .

:ComplianceManagement a tbox:ConceptualEntity ;
    rdfs:label "Compliance management"@en ;
    rdfs:subClassOf :GovernanceActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Regulatory_compliance> ;
    rdfs:comment "An engineering activity concerned with ensuring that software systems, processes, and associated artifacts comply with applicable regulations, standards, policies, and governance requirements."@en .

:ConcurrencyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Concurrency concept"@en ;
        rdfs:comment "A primitive language concept concerning the execution of multiple computations with overlapping or coordinated progress."@en .

:ConfigurationManagementPlanning a tbox:ConceptualEntity ;
    rdfs:label "Configuration management planning"@en ;
    rdfs:subClassOf :ManagementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Configuration_management> ;
    rdfs:comment "An engineering activity concerned with planning how software configuration items, versions, changes, and related configuration information are identified, controlled, and managed throughout a project."@en .

:ConstraintConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Constraint concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept for expressing constraints that restrict the permitted states, values, or relationships in a system or its models."@en .

:ContinuousDelivery a tbox:ConceptualEntity ;
    rdfs:label "Continuous delivery"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_delivery> ;
    rdfs:comment "A software engineering activity that automates and streamlines the delivery of software changes so that they can be released to production reliably and frequently."@en .

:ContinuousDeployment a tbox:ConceptualEntity ;
    rdfs:label "Continuous deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_deployment> ;
    rdfs:comment "A software engineering practice in which code changes that pass automated testing are automatically released to production environments."@en .

:ContinuousIntegration a tbox:ConceptualEntity ;
    rdfs:label "Continuous integration"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Continuous_integration> ;
    rdfs:comment "A software engineering practice in which code changes are frequently integrated into a shared repository and automatically built and tested to detect integration issues early."@en .

:ControlConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Control concept"@en ;
        rdfs:comment "A primitive language concept concerned with directing the order and conditions under which computations are performed, such as through branching, iteration, recursion, or continuations."@en .

:DataConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Data concept"@en ;
        rdfs:comment "A primitive language concept concerning the representation, organization, and manipulation of data, including data values, structured data types, references, and recursive data."@en .

:DataModelDesign a tbox:ConceptualEntity ;
    rdfs:label "Data model design"@en ;
    tbox:hasSupportingLanguage le:DataDefinitionLanguage,
        le:OntologyLanguage,
        le:SemanticDataModelLanguage ;
    tbox:uses fe:DataManagementApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Data_model> ;
    rdfs:comment "The engineering activity of designing data models that define the structure, relationships, and constraints of data for a system."@en .

:DependencyManagement a tbox:ConceptualEntity ;
    rdfs:label "Dependency management"@en ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Package_manager> ;
    rdfs:comment "An implementation activity concerned with declaring, resolving, versioning, and maintaining the external software dependencies required by a project."@en .

:Deployment a tbox:ConceptualEntity ;
    rdfs:label "Deployment"@en ;
    rdfs:subClassOf :DeploymentActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_deployment> ;
    rdfs:comment "The software engineering activity of making a software system available and operational in a target environment."@en .

:DesignActivity a tbox:ConceptualEntity ;
    rdfs:label "Design activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "An engineering activity concerned with defining a software system's structure, components, interfaces, and other characteristics to meet specified requirements."@en .

:DesignValidation a tbox:ConceptualEntity ;
    rdfs:label "Design validation"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "An engineering activity that verifies whether a software design satisfies its specified requirements and intended purpose."@en .

:DevOpsPractice a tbox:ConceptualEntity ;
    rdfs:label "DevOps practice"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/DevOps> ;
    rdfs:comment "A software engineering practice that integrates and coordinates software development and IT operations to support the delivery, deployment, and operation of software systems."@en .

:Documentation a tbox:ConceptualEntity ;
    rdfs:label "Documentation"@en ;
    rdfs:subClassOf :QualityManagementActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Documentation> ;
    rdfs:comment "An engineering activity concerned with creating, maintaining, and managing documentation that describes software systems, their use, design, or development processes."@en .

:EffectConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Effect concept"@en ;
        rdfs:comment "A primitive language concept concerning computational effects, such as side effects, input/output, exceptions, or the distinction between effectful and pure computation."@en .

:EffortEstimation a tbox:ConceptualEntity ;
    rdfs:label "Effort estimation"@en ;
    rdfs:subClassOf :PlanningActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_development_effort_estimation> ;
    rdfs:comment "Planning and management activity concerned with estimating the effort required to develop a software system or project."@en .

:EnvironmentProvisioning a tbox:ConceptualEntity ;
    rdfs:label "Environment provisioning"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Provisioning> ;
    rdfs:comment "A support activity concerned with preparing and configuring the computing environments, infrastructure, and resources required for software development, deployment, or operation."@en .

:ErrorHandlingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Error handling concept"@en ;
        rdfs:comment "A primitive language concept concerned with detecting, reporting, managing, and recovering from errors or exceptional conditions during program execution."@en .

:EvaluationStrategyConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Evaluation strategy concept"@en ;
        rdfs:comment "A primitive language concept that characterizes the rules determining when and how expressions or function arguments are evaluated during program execution."@en .

:EvolutionActivity a tbox:ConceptualEntity ;
    rdfs:label "Evolution activity"@en ;
    rdfs:comment "An engineering activity concerned with changing, adapting, or evolving software and related artifacts over time."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_evolution> .

:ImprovementActivity a tbox:ConceptualEntity ;
    rdfs:label "Improvement activity"@en ;
    rdfs:comment "An engineering activity aimed at improving the quality, maintainability, functionality, or other desirable properties of software and related artifacts."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:Experimentation a tbox:ConceptualEntity ;
    rdfs:label "Experimentation"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Experiment> ;
    rdfs:comment "A support activity involving the systematic performance of experiments to investigate, evaluate, or validate aspects of software languages, tools, or engineering processes."@en .

:FeatureEnhancement a tbox:ConceptualEntity ;
    rdfs:label "Feature enhancement"@en ;
    rdfs:subClassOf :ImprovementActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_evolution> ;
    rdfs:comment "An evolution and improvement activity that adds new or enhanced functionality to an existing software system."@en .

:FormalVerification a tbox:ConceptualEntity ;
    rdfs:label "Formal verification"@en ;
    tbox:hasInputArtifact ae:ModelArtifact,
        ae:ProgramArtifact ;
    tbox:hasSupportingLanguage le:ModelingLanguage,
        le:ProofLanguage,
        pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:ProofAssistant ;
    tbox:uses fe:FormalSemanticsApproach,
        fe:ProgramLogic,
        fe:TypeTheory ;
    rdfs:subClassOf :VerificationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Formal_verification> ;
    rdfs:comment "The activity of establishing, by mathematically rigorous methods, that a program or model satisfies its specified properties."@en .

:GrammarConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Grammar concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning grammars: formal rule systems used to specify the syntactic structure of languages."@en .

:HigherOrderConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Higher-order concept"@en ;
        rdfs:comment "A primitive language concept concerning entities that can take, return, manipulate, or be parameterized by other entities."@en .

:HighLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "High-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software design activity that defines the overall architecture, major components, and high-level structure of a software system."@en .

:Implementation a tbox:ConceptualEntity ;
    rdfs:label "Implementation"@en ;
    tbox:hasOutputArtifact ae:ProgramArtifact ;
    tbox:hasSupportingLanguage pe:ProgrammingLanguage ;
    tbox:hasSupportingTool te:Compiler,
        te:Interpreter ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :ImplementationActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "An engineering activity that produces a program by realizing a software design using programming languages and supporting tools such as compilers or interpreters."@en .

:ImplementationActivity a tbox:ConceptualEntity ;
    rdfs:label "Implementation activity"@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Implementation> ;
    rdfs:comment "A category of software engineering activities concerned with implementing, constructing, and maintaining software artifacts."@en .

:IncidentManagement a tbox:ConceptualEntity ;
    rdfs:label "Incident management"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Incident_management> ;
    rdfs:comment "An operations and maintenance activity concerned with managing the lifecycle of incidents, including their identification, resolution, and restoration of normal service."@en .

:IntegrationTesting a tbox:ConceptualEntity ;
    rdfs:label "Integration testing"@en ;
    rdfs:subClassOf :VerificationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Integration_testing> ;
    rdfs:comment "A verification testing activity that evaluates the interactions and interfaces among integrated software components or subsystems."@en .

:InterfaceDesign a tbox:ConceptualEntity ;
    rdfs:label "Interface design"@en ;
    tbox:hasOutputArtifact ae:APIDescriptionArtifact ;
    tbox:hasSupportingLanguage le:InterfaceDescriptionLanguage ;
    tbox:hasSupportingTool te:APIWorkbench ;
    tbox:uses fe:SoftwareDesignApproach ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Interface_(computing)> ;
    rdfs:comment "The software design activity of defining interfaces between software components or systems, including the services, operations, and interaction contracts they expose."@en .

:KnowledgeManagement a tbox:ConceptualEntity ;
    rdfs:label "Knowledge management"@en ;
    rdfs:subClassOf :SupportActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Knowledge_management> ;
    rdfs:comment "The systematic process of creating, organizing, sharing, and using knowledge within an organization to support its activities and objectives."@en .

:KnowledgeRepresentationConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Knowledge-representation concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "concept concerning the representation of knowledge in a form that can be processed, queried, or reasoned about by computational systems"@en .

:LifetimeConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Lifetime concept"@en ;
        rdfs:comment "A primitive language concept that characterizes the duration for which an entity, such as an object or allocated memory, exists and remains valid during program execution."@en .

:Logging a tbox:ConceptualEntity ;
    rdfs:label "Logging"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Logging_(computing)> ;
    rdfs:comment "An operations and maintenance activity that records events, messages, and system state information to support monitoring, diagnosis, auditing, and troubleshooting."@en .

:LowLevelDesign a tbox:ConceptualEntity ;
    rdfs:label "Low-level design"@en ;
    rdfs:subClassOf :DesignActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_design> ;
    rdfs:comment "A software design activity that specifies the detailed internal structure, components, interfaces, and implementation-level aspects of a system."@en .

:MetaprogrammingConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Metaprogramming concept"@en ;
        rdfs:comment "A language concept concerning the development of programs that manipulate, generate, analyze, or transform other programs or themselves."@en .

:Migration a tbox:ConceptualEntity ;
    rdfs:label "Migration"@en ;
    rdfs:subClassOf :EvolutionActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Migration_(software)> ;
    rdfs:comment "An evolution and improvement activity that moves software, data, or systems from one environment, platform, technology, or version to another."@en .

:ModelingConcept a tbox:LanguageConcept,
        tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Modeling concept"@en ;
    rdfs:subClassOf tbox:LanguageConcept ;
        rdfs:comment "A language concept concerning the representation, structure, and use of models in software and systems development."@en .

:ModularityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Modularity concept"@en ;
        rdfs:comment "A primitive language concept concerned with organizing a software system into separate, cohesive modules and managing their interfaces, dependencies, and composition."@en .

:Monitoring a tbox:ConceptualEntity ;
    rdfs:label "Monitoring"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/System_monitoring> ;
    rdfs:comment "An operations and maintenance activity that observes the status, performance, and behavior of software systems or their supporting infrastructure."@en .

:MutabilityConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Mutability concept"@en ;
        rdfs:comment "A primitive language concept concerning whether data or objects can be modified after creation, including mutable and immutable data and associated value or reference semantics."@en .

:OperationsActivity a tbox:ConceptualEntity ;
    rdfs:label "Operations activity"@en ;
    rdfs:comment "An engineering activity concerned with operating, monitoring, and managing a deployed software system."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:MaintenanceActivity a tbox:ConceptualEntity ;
    rdfs:label "Maintenance activity"@en ;
    rdfs:comment "An engineering activity concerned with modifying or restoring deployed software to correct faults, recover service, or improve its continued operation."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_maintenance> .

:Packaging a tbox:ConceptualEntity ;
    rdfs:label "Packaging"@en ;
    rdfs:subClassOf :ReleaseActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Software_packaging> ;
    rdfs:comment "A release and deployment activity that prepares software for distribution by bundling it with its required files, metadata, dependencies, and installation instructions."@en .

:ParadigmConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Paradigm concept"@en ;
        rdfs:comment "A primitive language concept that characterizes a fundamental style or model of computation, such as declarative, imperative, functional, logic, or object-oriented programming."@en .

:ParallelismConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:subClassOf :PrimitiveConcept ;
        rdfs:label "Parallelism concept"@en ;
        rdfs:comment "A primitive language concept concerning the simultaneous execution of multiple computations or activities."@en .

:Patching a tbox:ConceptualEntity ;
    rdfs:label "Patching"@en ;
    rdfs:subClassOf :MaintenanceActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Patch_(computing)> ;
    rdfs:comment "An operations and maintenance activity that applies patches to software to correct defects, address security vulnerabilities, or update functionality."@en .

:PerformanceTesting a tbox:ConceptualEntity ;
    rdfs:label "Performance testing"@en ;
    rdfs:subClassOf :ValidationTestingActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "A validation testing activity that evaluates a system's responsiveness, throughput, scalability, stability, and resource utilization under expected or varying workloads."@en .

:PerformanceTuning a tbox:ConceptualEntity ;
    rdfs:label "Performance tuning"@en ;
    rdfs:subClassOf :OperationsActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Performance_testing> ;
    rdfs:comment "Software engineering activity concerned with improving the performance of a software system, such as its execution time, resource usage, or throughput."@en .

:PlanningActivity a tbox:ConceptualEntity ;
    rdfs:label "Planning activity"@en ;
    rdfs:comment "An engineering activity concerned with defining objectives, plans, schedules, or intended courses of action for software development or related work."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:ManagementActivity a tbox:ConceptualEntity ;
    rdfs:label "Management activity"@en ;
    rdfs:comment "An engineering activity concerned with organizing, allocating, monitoring, controlling, or coordinating resources, risks, stakeholders, or configuration items."@en ;
    rdfs:subClassOf tbox:EngineeringActivity ;
    foaf:page <https://en.wikipedia.org/wiki/Software_project_management> .

:PrimitiveConcept a tbox:ConceptualEntity,
        owl:Class ;
    rdfs:label "Primitive concept"@en ;
