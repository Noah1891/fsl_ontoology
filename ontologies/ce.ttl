    foaf:page <https://en.wikipedia.org/wiki/Software_quality> .

:GovernanceActivity a tbox:ConceptualEntity ;
    rdfs:label "Governance activity"@en ;
    rdfs:comment "An engineering activity concerned with oversight, compliance, accountability, security governance, or the documentation required to support these concerns."@en ;
    rdfs:subClassOf tbox:EngineeringActivity .

:QualityAssurance a tbox:ConceptualEntity ;
    rdfs:label "Quality assurance"@en ;
    rdfs:subClassOf :QualityActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Quality_assurance> ;
    rdfs:comment "An engineering activity concerned with ensuring that software products and processes meet specified quality requirements and standards."@en .

:QualityControl a tbox:ConceptualEntity ;
    rdfs:label "Quality control"@en ;
    rdfs:subClassOf :QualityActivity ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Quality_control> ;
    rdfs:comment "An engineering activity concerned with monitoring, evaluating, and verifying that software products, processes, or services meet specified quality requirements and standards."@en .

:QueryConcept a tbox:LanguageConcept,
